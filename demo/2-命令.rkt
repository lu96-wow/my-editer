#lang racket

;;; ============================================================================
;;; core-chinese/demo/2-命令.rkt —— editor 层用法演示（程序面 + 用户面）
;;; ============================================================================
;;;
;;;   racket core-chinese/demo/2-命令.rkt
;;;
;;; 覆盖：
;;;   program.rkt —— 编辑原语 编辑器-命令 / 编辑器-命令-批、编辑动作、薄封装、显式视口命令
;;;   command.rkt —— 用户命令（主导+确保+账本）：编辑器-编辑 / 导航 / 撤销 / 重做 / 跟随
;;;
;;; 一条命令返回 (values 编辑器 (or/c #f 变更-报告))；变更-报告 带生效文本/属性（施加顺序）。
;;; 视图命令（编辑器-视口-设置-*）只返回编辑器（单值）。

(require "../core-chinese/editor.rkt"
         "../core-chinese/api.rkt")

(define (show 表达式 值)
  (printf "~a\n    => ~s\n" 表达式 值))

(define (显示报告 标签 ed 报告)
  (printf "~a\n    => 文本 ~s | 报告: ~a\n"
          标签
          (编辑器-文档->字符串 ed)
          (if 报告
              (list '首行 (变更-报告-首-行 报告) '末行 (变更-报告-末-行 报告)
                    '文本集 (变更-报告-文本集 报告))
              '#f)))

(printf "\n================ 0. 编辑原语 编辑器-命令 ================\n")

(define ed0 (编辑器-打开 "hello"))

;; 编辑器-命令 : 编辑器 操作 [策略参数…] → (values 编辑器 变更-报告/#f)
;;   操作 = (编辑器 文档标识 选区 → 编辑-描述/#f)，只**算**不施加。
;;   默认 #:反应 'none（程序默认：内容变、视图字面不动）。
(define-values (ed1 r1) (编辑器-命令 ed0 (编辑-插入 ">> ")))
(显示报告 "(编辑器-命令 ed0 (编辑-插入 \">> \"))  默认 none：光标字面不动" ed1 r1)
(show "编辑器-位置 ed1（不动）" (编辑器-位置 ed1))

;; #:反应 '主导：把目标视口推进到插入后 + 确保（用户编辑的语义）。
(define-values (ed2 r2) (编辑器-命令 ed0 (编辑-插入 ">> ")
                                      #:反应 '主导 #:记录? #f))
(显示报告 "(编辑器-命令 ed0 (编辑-插入 \">> \") #:反应 '主导 #:记录? #f)" ed2 r2)
(show "编辑器-位置 ed2（推进到插入后）" (编辑器-位置 ed2))

;; #:视口 / #:选区：显式目标视口与编辑上下文（这里选中 [0,5) 再整体替换）。
(define-values (ed3 r3) (编辑器-命令 ed0 (编辑-插入 "HELLO")
                                      #:选区 (list (选区 (位置 0 0) (位置 0 5)))
                                      #:反应 '主导))
(显示报告 "(编辑器-命令 ed0 … #:选区 (list (选区 (位置 0 0) (位置 0 5))))" ed3 r3)

;; #:编辑前位置：撤销回落的编辑前光标（覆盖默认的“主选区头部”）。
(define-values (ed4 r4) (编辑器-命令 ed0 (编辑-插入 "X")
                                      #:反应 '主导 #:编辑前位置 (位置 0 3)))
;; 撤销后光标回到 #:编辑前位置
(define-values (ed4u _r4u) (编辑器-撤销 ed4))
(show "#:编辑前位置 (位置 0 3) → 撤销后光标回这里" (编辑器-位置 ed4u))

;; #:属性集：属性计划，在文本描述夹紧后求值（坐标 = 文本生效之后），与文本合成同一条变更。
;;   计划 : (编辑器 文档标识 生效描述集 → (listof 属性-描述))
(define-values (ed5 r5)
  (编辑器-命令 ed0 (编辑-插入 "AB")
                #:属性集 (lambda (e d ds)
                          (define p (编辑-描述-起点 (car ds)))
                          (list (属性-设置 p (位置 0 2) '外观 (hash '外观 '关键字))))
                #:反应 '主导))
(显示报告 "(编辑器-命令 ed0 (编辑-插入 \"AB\") #:属性集 …)" ed5 r5)
(show "属性已随文本一次施加：键片段集"
      (编辑器-文档-属性集-键-片段集 ed5 0 0 '外观))

;; #:受信?：只读区默认拒绝编辑（返回报告 #f）；#:受信? #t 强写。
(define-values (edRO _rRO0) (编辑器-文档-安装-属性 ed0 0 '只读 0 0 5 #t))
(define-values (edRO1 rRO1) (编辑器-命令 edRO (编辑-插入 "X") #:反应 '主导))
(显示报告 "(编辑器-命令 edRO (编辑-插入 \"X\"))  只读守卫 → 拒绝" edRO1 rRO1)
(define-values (edRO2 rRO2) (编辑器-命令 edRO (编辑-插入 "X") #:受信? #t #:反应 '主导))
(显示报告 "(编辑器-命令 edRO (编辑-插入 \"X\") #:受信? #t)  强写" edRO2 rRO2)

;; 编辑器-命令-批 : 直接吃现成的变更（不做选区→操作那步）。适合程序化批量替换。
(define-values (edB rB) (编辑器-命令-批 ed0 (编辑列表->变更 (list (编辑-描述 (位置 0 0) (位置 0 5) "HI")))))
(显示报告 "(编辑器-命令-批 ed0 (编辑列表->变更 (list (编辑-描述 …))))" edB rB)

(printf "\n================ 1. 编辑动作（op 值：只算不施加） ================\n")

;; 操作形状统一是 (编辑器 文档标识 选区 → 编辑-描述/#f)；这些是常用动作构造器。
(show "(编辑-插入 \"abc\")           ; 返回一个 op" (编辑-插入 "abc"))
(show "(编辑-插入-字符 #\\x)" (编辑-插入-字符 #\x))
(show "(编辑-换行)" (编辑-换行))
(show "(编辑-退格)" (编辑-退格))
(show "(编辑-删除)" (编辑-删除))
(show "(编辑-拼接 (位置 0 0) (位置 0 2) \"ZZ\")" (编辑-拼接 (位置 0 0) (位置 0 2) "ZZ"))

;; 用 编辑器-命令 施加其中一个：
(define-values (ed6 _r6) (编辑器-命令 ed0 (编辑-换行) #:反应 '主导))
(显示报告 "(编辑器-命令 ed0 (编辑-换行) #:反应 '主导)" ed6 _r6)

(printf "\n================ 2. 薄封装：编辑器-文档-编辑-在 / -批 ================\n")

;; 编辑器-文档-编辑-在 : 显式位置，构造单光标选区后走 编辑器-命令；默认 #:反应 'none。
;;   #:反应 / #:受信? / #:记录? 三个策略可直接透传。
(define-values (ed7 r7) (编辑器-文档-编辑-在 ed0 0 (位置 0 0) (编辑-插入 "> ")))
(显示报告 "(编辑器-文档-编辑-在 ed0 0 (位置 0 0) (编辑-插入 \"> \"))" ed7 r7)

;; 编辑器-文档-编辑-在-批 : 给一串现成 编辑-描述；#:编辑前位置 自动取最左施加点。
(define-values (ed8 r8)
  (编辑器-文档-编辑-在-批 ed0 0 (list (编辑-描述 (位置 0 0) (位置 0 1) "J")
                                       (编辑-描述 (位置 0 1) (位置 0 2) "K"))))
(显示报告 "(编辑器-文档-编辑-在-批 ed0 0 (list …))" ed8 r8)

(printf "\n================ 3. 显式视口命令（只动指定视口，不镜像/不抢焦点/不确保） ================\n")

;; 准备一个双视口编辑器：视口 0（焦点）、视口 1（#:焦点? #f 不抢）。
(define edV0 (编辑器-打开 "l0\nl1\nl2\nl3\nl4" 3 12))
(define-values (edV1 视口1) (编辑器-添加-视口 edV0 0 3 12 #:焦点? #f))
(define 文档0 0)
(show "初始：编辑器-位置（焦点=视口0）" (编辑器-位置 edV1))
(show "初始：编辑器-视口-位置 视口1" (编辑器-视口-位置 edV1 视口1))

;; 编辑器-视口-设置-位置 : 裸写光标（只夹紧，不同步）。
(define edV2 (编辑器-视口-设置-位置 edV1 视口1 (位置 2 0)))
(show "编辑器-视口-设置-位置 edV1 视口1 (位置 2 0)  焦点不受影响"
      (list (编辑器-视口-位置 edV2 视口1) (编辑器-位置 edV2)))

;; 编辑器-视口-安装-窗口 : 换整个窗口值（文档必须就是该视口的当前文档）。
(define edV3 (编辑器-视口-安装-窗口 edV2 视口1 (窗口-设置-模式 (编辑器-视口-窗口 edV2 视口1) '折行)))
(show "编辑器-视口-安装-窗口 … 窗口-设置-模式 '折行" (编辑器-视口-模式 edV3 视口1))

;; 选区：设置/安装/清空/添加/移除/收敛/映射。
(define selA (选区 (位置 0 0) (位置 0 2)))
(define selB (选区 (位置 2 0) (位置 2 2)))
(define edV4 (编辑器-视口-设置-选区列表 edV3 视口1 (list selA selB) 1))
(show "编辑器-视口-设置-选区列表 … (list selA selB) 1  主选区索引=1"
      (list (编辑器-视口-选区列表 edV4 视口1) (编辑器-视口-主选区-索引 edV4 视口1)))
(define edV5 (编辑器-视口-添加-选区列表 edV4 视口1 (list (插入符 (位置 1 0))) #:主选区? #t))
(show "编辑器-视口-添加-选区列表 … #:主选区? #t" (编辑器-视口-选区列表 edV5 视口1))
(show "编辑器-视口-选区-成员? edV5 视口1 (插入符 (位置 1 0))"
      (编辑器-视口-选区-成员? edV5 视口1 (插入符 (位置 1 0))))
(define edV6 (编辑器-视口-移除-选区列表 edV5 视口1 (list (插入符 (位置 1 0)))))
(show "编辑器-视口-移除-选区列表 …" (编辑器-视口-选区列表 edV6 视口1))

;; 映射算子：对每个选区 / 只对主选区 / 对每个头部施 位置→位置。
(define edV7 (编辑器-视口-映射-位置列表 edV6 视口1 (lambda (p) (位置 0 0))))
(show "编辑器-视口-映射-位置列表 … (λ(p)(位置 0 0))" (编辑器-视口-选区列表 edV7 视口1))
(define edV8 (编辑器-视口-映射-主选区 edV7 视口1 (lambda (s) (选区 (位置 0 0) (位置 0 3)))))
(show "编辑器-视口-映射-主选区 …" (编辑器-视口-主选区 edV8 视口1))
(define edV9 (编辑器-视口-映射-选区列表 edV8 视口1 (lambda (s) (选区 (位置 0 0) (位置 0 1)))))
(show "编辑器-视口-映射-选区列表 …" (编辑器-视口-选区列表 edV9 视口1))

;; 命名选区集：安装 / 清空（收敛为单个主导）。何时清理由上层决定。
(define g (选区集-打开 '查找 (list selA selB) 0))
(define edV10 (编辑器-视口-安装-选区集 edV9 视口1 g))
(show "编辑器-视口-安装-选区集 … (选区集-打开 '查找 …)"
      (list (编辑器-视口-选区集-名称 edV10 视口1) (编辑器-视口-选区列表 edV10 视口1)))
(define edV11 (编辑器-视口-清空-选区集 edV10 视口1))
(show "编辑器-视口-清空-选区集 …" (编辑器-视口-选区集-名称 edV11 视口1))

;; 收敛 / 设置主选区 / 设置主选区索引。
(define edV12 (编辑器-视口-收敛-选区列表 edV6 视口1))
(show "编辑器-视口-收敛-选区列表 …（坍缩成单个主选区）" (编辑器-视口-选区列表 edV12 视口1))
(define edV13 (编辑器-视口-设置-主选区 edV6 视口1 selB))
(show "编辑器-视口-设置-主选区 …" (编辑器-视口-主选区 edV13 视口1))
(define edV14 (编辑器-视口-设置-主选区-索引 edV6 视口1 1))
(show "编辑器-视口-设置-主选区-索引 … 1" (编辑器-视口-主选区-索引 edV14 视口1))

;; 尺寸 / 模式 / 行号 / 滚动位置（视图态）。
(define edV15 (编辑器-视口-设置-尺寸 edV6 视口1 4 16))
(show "编辑器-视口-设置-尺寸 … 4 16"
      (list (编辑器-视口-高度 edV15 视口1) (编辑器-视口-宽度 edV15 视口1)))
(define edV16 (编辑器-视口-设置-模式 edV15 视口1 '折行))
(show "编辑器-视口-设置-模式 … '折行" (编辑器-视口-模式 edV16 视口1))
(define edV17 (编辑器-视口-设置-行号 edV16 视口1 #t))
(show "编辑器-视口-设置-行号 … #t" (编辑器-视口-行号? edV17 视口1))
(define edV18 (编辑器-视口-设置-顶行 edV17 视口1 2))
(define edV18b (编辑器-视口-设置-左列 edV18 视口1 1))
(define edV18c (编辑器-视口-设置-顶段 edV18b 视口1 0))
(show "编辑器-视口-设置-顶行/左列/顶段 …"
      (list (编辑器-视口-顶行 edV18c 视口1) (编辑器-视口-左列 edV18c 视口1) (编辑器-视口-顶段 edV18c 视口1)))

;; 结构变换：同步策略 / 属主文档（不触发同步）。
(define edV19 (编辑器-视口-设置-同步 edV6 视口1 '跟随))
(show "编辑器-视口-设置-同步 … '跟随" (编辑器-视口-同步 edV19 视口1))
(define edV20 (编辑器-视口-设置-文档 edV6 视口1 文档0))
(show "编辑器-视口-设置-文档 …" (编辑器-视口-文档-标识 edV20 视口1))

(printf "\n================ 4. 焦点糖（省略 视口标识 = 焦点视口） ================\n")

;; 与上面一一对应，只是作用于焦点视口。
(define edF1 (编辑器-设置-位置 edV1 (位置 1 0)))
(show "编辑器-设置-位置 …" (编辑器-位置 edF1))
(define edF2 (编辑器-设置-选区列表 edV1 (list (选区 (位置 0 0) (位置 0 2)))))
(show "编辑器-设置-选区列表 …" (编辑器-选区列表 edF2))
(define edF3 (编辑器-添加-选区列表 edV1 (list (插入符 (位置 2 0))) #:主选区? #t))
(show "编辑器-添加-选区列表 …" (编辑器-选区列表 edF3))
(define edF4 (编辑器-设置-模式 edV1 '折行))
(show "编辑器-设置-模式 '折行" (编辑器-模式 edF4))
(define edF5 (编辑器-设置-行号 edV1 #t))
(show "编辑器-设置-行号 #t" (编辑器-行号? edF5))
(define edF6 (编辑器-设置-尺寸 edV1 5 30))
(show "编辑器-设置-尺寸 5 30" (list (编辑器-高度 edF6) (编辑器-宽度 edF6)))
(define edF7 (编辑器-设置-同步 edV1 '跟随))
(show "编辑器-设置-同步 '跟随" (编辑器-同步 edF7))

(printf "\n================ 5. 用户编辑 / 导航 / 撤销 / 重做 ================\n")

;; 编辑器-编辑 : 焦点视口的用户编辑 = 编辑器-命令 + #:反应 '主导 + #:记录? '默认。
(define u0 (编辑器-打开 "abc"))
(define-values (u1 ur1) (编辑器-编辑 u0 (编辑-插入-字符 #\a)))
(define-values (u2 _ur2) (编辑器-编辑 u1 (编辑-插入-字符 #\b)))
(define-values (u3 _ur3) (编辑器-编辑 u2 (编辑-插入-字符 #\c)))
(显示报告 "(编辑器-编辑 u0 (编辑-插入-字符 #\\a)) 连续三次" u3 ur1)
(show "撤销深度（连续打字并成 1 步）" (编辑器-文档-撤销-深度 u3 0))
(define-values (u4 ur4) (编辑器-撤销 u3))
(显示报告 "(编辑器-撤销 u3)" u4 ur4)
(show "撤销后光标（回到编辑前）" (编辑器-位置 u4))
(define-values (u5 _ur5) (编辑器-重做 u4))
(显示报告 "(编辑器-重做 u4)" u5 _ur5)

;; 显式视口版：编辑器-视口-编辑 / 编辑器-视口-撤销 / 编辑器-视口-重做。
(define væ (编辑器-打开 "XYZ" 2 10))
(define-values (væ1 _) (编辑器-视口-编辑 væ 0 (编辑-插入 "!")))
(显示报告 "(编辑器-视口-编辑 væ 0 (编辑-插入 \"!\"))" væ1 _)

;; 导航：编辑器-左/右/上/下/行首/末尾/跳转/滚动（= 裸写 + 窗口-* + 确保 + 跟随镜像）。
(define n0 (编辑器-打开 "l0\nl1\nl2\nl3\nl4\nl5"))
(show "(编辑器-右 (编辑器-下 n0))" (编辑器-位置 (编辑器-右 (编辑器-下 n0))))
(show "(编辑器-末尾 n0)" (编辑器-位置 (编辑器-末尾 n0)))
(show "(编辑器-跳转 n0 (位置 3 0)) 顶行" (编辑器-顶行 (编辑器-跳转 n0 (位置 3 0))))
(show "(编辑器-滚动 n0 2) 顶行" (编辑器-顶行 (编辑器-滚动 n0 2)))
(show "(编辑器-行首 (编辑器-跳转 n0 (位置 2 1)))" (编辑器-位置 (编辑器-行首 (编辑器-跳转 n0 (位置 2 1)))))
(show "(编辑器-上 (编辑器-跳转 n0 (位置 2 0)))" (编辑器-位置 (编辑器-上 (编辑器-跳转 n0 (位置 2 0)))))

;; 显式视口导航：只动目标视口，焦点视口不动。
(define nv0 (编辑器-打开 "l0\nl1\nl2"))
(define-values (nv1 视口nv) (编辑器-添加-视口 nv0 0 2 10 #:焦点? #f))
(define nv2 (编辑器-视口-跳转 nv1 视口nv (位置 2 0)))
(show "(编辑器-视口-跳转 nv1 视口nv (位置 2 0))  焦点不动"
      (list (编辑器-视口-位置 nv2 视口nv) (编辑器-位置 nv2)))

;; 跟随：以该视口当前窗口为准，镜像同文档 '跟随 视口 + 同链接成员（可跨文档）。
(define f0 (编辑器-打开 (string-join (map number->string (range 30)) "\n") 5 20))
(define-values (f1 视口f) (编辑器-添加-视口 f0 0 5 20 #:同步 '跟随 #:焦点? #f))
(define f2 (编辑器-跳转 f1 (位置 20 0)))
(define f3 (编辑器-视口-跟随 f2 0))
