#lang racket

;;; ============================================================================
;;; demo/4-投影与报告.rkt —— editor 层用法演示（投影 / 坐标 / 变更-报告）
;;; ============================================================================
;;;
;;;   racket demo/4-投影与报告.rkt
;;;
;;; 覆盖：
;;;   变更-报告   变更-报告? / 首-行 / 末-行 / 文本集 / 属性集
;;;   投影        编辑器->屏幕 / 编辑器-视口->屏幕 / 空外观提供者 / 属性集-提供者
;;;   坐标        编辑器-位置->屏幕 / 编辑器-屏幕->位置（含显式视口版）
;;;   屏幕读口    屏幕-高度 / 屏幕-宽度 / 屏幕-屏行 / 屏幕-屏行->字符串（来自 api.rkt）
;;;
;;; 两条数据流在这里汇合：
;;;   内容流 op → 编辑-描述 → 变更 → 文档-施加-变更  →（变更-报告 回给调用方）
;;;   渲染流 缓冲 → 渲染 → 片段 → 窗口->屏幕 → 屏幕（后端负责画）

(require "../core-chinese/editor.rkt"
         "../core-chinese/api.rkt")

(define (show 表达式 值)
  (printf "~a\n    => ~s\n" 表达式 值))

(printf "\n================ 0. 变更-报告（命令的第二个返回值） ================\n")

;; 命令返回 (values 编辑器 变更-报告/#f)。报告携带**生效**文本/属性（施加顺序）与影响行区间。
(define ed0 (编辑器-打开 "hello\nworld"))
(define-values (ed1 报告) (编辑器-文档-编辑-在 ed0 0 (位置 0 0) (编辑-插入 "> ")))
(show "编辑器-文档-编辑-在 … → 报告" 报告)
(show "变更-报告? 报告" (变更-报告? 报告))
(show "变更-报告-文本集 报告（生效 编辑-描述，施加顺序）" (变更-报告-文本集 报告))
(show "变更-报告-属性集 报告" (变更-报告-属性集 报告))
(show "变更-报告-首-行 / 末-行（影响行区间，无 → #f）"
      (list (变更-报告-首-行 报告) (变更-报告-末-行 报告)))

(printf "\n================ 1. 投影：编辑器 -> 屏幕 ================\n")

;; 编辑器->屏幕 : 编辑器 [外观-提供者] → 屏幕
;;   外观-提供者 : (编辑器 文档标识 行 → 片段集)，派生外观现算、不存文档。
;;   默认 空外观提供者（没有高亮）。
(define scr0 (编辑器->屏幕 ed1))
(show "(编辑器->屏幕 ed1)  帧尺寸" (list (屏幕-高度 scr0) (屏幕-宽度 scr0)))
(show "屏幕-屏行 scr0 0 / 1" (list (屏幕-屏行 scr0 0) (屏幕-屏行 scr0 1)))
(show "屏幕-屏行->字符串 scr0 0" (屏幕-屏行->字符串 scr0 0))

;; 编辑器-视口->屏幕 : 按显式视口投影（先开一个窄视口，让它折行，看看投影差异）。
(define-values (ed2 窄视口) (编辑器-添加-视口 ed1 0 4 6 #:焦点? #f))
(define 窄屏 (编辑器-视口->屏幕 ed2 窄视口))
(show "(编辑器-视口->屏幕 ed2 窄视口) 各屏行文本"
      (for/list ([i (in-range (屏幕-高度 窄屏))]) (屏幕-屏行->字符串 窄屏 i)))

(printf "\n================ 2. 外观-提供者：把属性物化成高亮 ================\n")

;; 先写一段属性：第 0 行 [1,3) 标成 关键字。
(define-values (ed3 _r3) (编辑器-文档-安装-属性 ed1 0 '外观 0 1 3 (hash '外观 '关键字)))
(show "无提供者（默认 空外观提供者）"
      (屏幕-屏行 (编辑器->屏幕 ed3) 0))
(show "属性集-提供者 '外观"
      (屏幕-屏行 (编辑器->屏幕 ed3 (属性集-提供者 '外观)) 0))
(show "空外观提供者 显式传入"
      (屏幕-屏行 (编辑器->屏幕 ed3 空外观提供者) 0))

(printf "\n================ 3. 坐标：位置 ↔ 屏幕 ================\n")

;; 编辑器-位置->屏幕 : 把**当前光标**投影成屏幕坐标 —— (values 屏行 屏幕列)；不可见 → (values #f #f)。
(define-values (屏行 屏幕列) (编辑器-位置->屏幕 ed1))
(show "(编辑器-位置->屏幕 ed1)  当前光标 -> 屏幕坐标" (list 屏行 屏幕列))

;; 编辑器-屏幕->位置 : 反投影（屏行 + 屏幕列 → 位置）；越界 → (values #f #f)。
(define-values (行 列) (编辑器-屏幕->位置 ed1 屏行 屏幕列))
(show "(编辑器-屏幕->位置 ed1 屏行 屏幕列)" (位置 行 列))

;; 显式视口版：编辑器-视口-位置->屏幕 / 编辑器-视口-屏幕->位置。
(define-values (v屏行 v屏幕列) (编辑器-视口-位置->屏幕 ed2 窄视口))
(show "(编辑器-视口-位置->屏幕 ed2 窄视口)  该视口光标 -> 屏幕坐标" (list v屏行 v屏幕列))
(define-values (v行 v列) (编辑器-视口-屏幕->位置 ed2 窄视口 v屏行 v屏幕列))
(show "(编辑器-视口-屏幕->位置 ed2 窄视口 …)" (位置 v行 v列))

(printf "\n================ 4. 行号栏对投影坐标的影响 ================\n")

;; 行号栏是视图装饰：栏 run 前置，光标/屏幕列右移栏宽。
(define edLN (编辑器-打开 "a\nb\nc" 3 10 #:行号? #t))
(show "行号栏开着：屏行 0 的片段（首段是 '行号 外观）"
      (屏幕-屏行 (编辑器->屏幕 edLN) 0))
(define-values (ln屏行 ln屏幕列) (编辑器-位置->屏幕 edLN))
(show "(编辑器-位置->屏幕 edLN)  光标屏幕列含栏宽偏移"
      (list ln屏行 ln屏幕列))

(printf "\ndemo/4-投影与报告.rkt 运行结束。\n")
