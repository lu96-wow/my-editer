#lang racket

;;; ============================================================================
;;; demo/3-属性与链接.rkt —— editor 层用法演示（属性写 / 历史策略 / 链接）
;;; ============================================================================
;;;
;;;   racket demo/3-属性与链接.rkt
;;;
;;; 覆盖：
;;;   属性写   编辑器-文档-施加-编辑列表 / 施加-属性集 / 安装-属性 / 移除-属性 / 替换-属性
;;;   历史策略 编辑器-设置-历史-启用 / 编辑器-视口-设置-历史-启用 / 清空-历史 / 历史启用?
;;;   文档名   编辑器-文档-设置-名称
;;;   链接     编辑器-视口-设置-链接 / 编辑器-设置-链接 / 编辑器-链接-视口列表 / 解除链接
;;;
;;; 两条边界：属性写与文本编辑走**同一条变更通道**（所以会记账、可撤销、光标不动）；
;;; 链接只同步**视口**（不改对方的文档，也不动对方的选区）。

(require "../core-chinese/editor.rkt"
         "../core-chinese/api.rkt")

(define (show 表达式 值)
  (printf "~a\n    => ~s\n" 表达式 值))

(define (显示报告 标签 ed 报告)
  (printf "~a\n    => 文本 ~s | 报告: ~a\n"
          标签
          (编辑器-文档->字符串 ed)
          (if 报告
              (list '文本集 (变更-报告-文本集 报告) '属性集 (变更-报告-属性集 报告))
              '#f)))

(printf "\n================ 0. 属性写（与文本同一条变更通道） ================\n")

(define ed0 (编辑器-打开 "hello world"))

;; 编辑器-文档-安装-属性 : 编辑器 文档标识 键 行 c0 c1 值 [#:记录? '默认]
;;   单段 设置；坐标 = 行 + 半开列区间（属性天生同行）。返回 (values 编辑器 变更-报告)。
(define-values (ed1 r1) (编辑器-文档-安装-属性 ed0 0 '外观 0 0 5 (hash '外观 '关键字)))
(显示报告 "(编辑器-文档-安装-属性 ed0 0 '外观 0 0 5 (hash '外观 '关键字))" ed1 r1)
(show "属性集-键-片段集" (编辑器-文档-属性集-键-片段集 ed1 0 0 '外观))

;; 编辑器-文档-移除-属性 : 同坐标，把该键的这段清掉。
(define-values (ed2 _r2) (编辑器-文档-移除-属性 ed1 0 '外观 0 0 5))
(show "(编辑器-文档-移除-属性 ed1 0 '外观 0 0 5)" (编辑器-文档-属性集-片段集 ed2 0 0))

;; 编辑器-文档-施加-属性集 : 一次写多段（listof 属性-描述）。
(define-values (ed3 _r3)
  (编辑器-文档-施加-属性集 ed0 0
    (list (属性-设置 (位置 0 0) (位置 0 3) '外观 (hash '外观 '粗体))
          (属性-设置 (位置 0 6) (位置 0 11) '外观 (hash '外观 '斜体)))))
(show "(编辑器-文档-施加-属性集 ed0 0 (list …))" (编辑器-文档-属性集-片段集 ed3 0 0))

;; 编辑器-文档-替换-属性 : 把某键在一段行范围内**整体替换**（先清后设）。
;;   跨度集 : (listof (list 行 c0 c1 值))；#:行列表 l0 l1 限定作用行范围（默认全文档）。
(define-values (ed4 _r4)
  (编辑器-文档-替换-属性 ed3 0 '外观
    (list (list 0 0 5 (hash '外观 '关键字)))
    #:行列表 0 0))
(show "(编辑器-文档-替换-属性 ed3 0 '外观 (list (list 0 0 5 …)) #:行列表 0 0)"
      (编辑器-文档-属性集-片段集 ed4 0 0))

;; 编辑器-文档-施加-编辑列表 : 直接给一串现成 编辑-描述（程序面批量文本，显式文档标识）。
(define-values (ed5 r5)
  (编辑器-文档-施加-编辑列表 ed0 0 (list (编辑-描述 (位置 0 0) (位置 0 5) "HELLO"))))
(显示报告 "(编辑器-文档-施加-编辑列表 ed0 0 (list (编辑-描述 …)))" ed5 r5)

(printf "\n================ 1. 属性写的三个「不」 ================\n")
(show "① 光标不动" (编辑器-位置 ed1))
(show "② 可撤销（撤销深度）" (编辑器-文档-撤销-深度 ed1 0))
(define-values (ed1u _r1u) (编辑器-撤销 ed1))
(show "③ 撤销后属性回来" (编辑器-文档-属性集-片段集 ed1u 0 0))

(printf "\n================ 2. 历史策略（记不记账本） ================\n")

;; 默认 #:历史? #t。查询：编辑器-文档-历史启用? / 编辑器-视口-历史启用?。
(show "(编辑器-文档-历史启用? ed0 0)" (编辑器-文档-历史启用? ed0 0))
(show "(编辑器-视口-历史启用? ed0 0)" (编辑器-视口-历史启用? ed0 0))

;; 编辑器-设置-历史-启用 : 焦点文档；编辑器-视口-设置-历史-启用 : 显式视口。
;;   关掉后，该文档后续编辑**不产账本**（适合派生/只读文档）。
(define edH1 (编辑器-设置-历史-启用 ed0 #f))
(show "(编辑器-设置-历史-启用 ed0 #f) → 历史启用?"
      (编辑器-文档-历史启用? edH1 0))
(define-values (edH2 _rH2) (编辑器-编辑 edH1 (编辑-插入 "x")))
(show "后台编辑后：文本 / 撤销深度"
      (list (编辑器-文档->字符串 edH2 0) (编辑器-文档-撤销-深度 edH2 0)))
(define edH3 (编辑器-设置-历史-启用 edH2 #t))
(show "重新打开（不隐式清栈）" (编辑器-文档-历史启用? edH3 0))

;; 编辑器-文档-清空-历史 : 清栈（保留策略）；编辑器-视口-清空-历史 : 显式视口版。
(define edH4 (编辑器-文档-清空-历史 edH3 0))
(show "(编辑器-文档-清空-历史 edH3 0) → 撤销深度" (编辑器-文档-撤销-深度 edH4 0))

;; 编辑器-视口-设置-历史-启用 / 编辑器-视口-清空-历史（显式视口标识）。
(define edH5 (编辑器-视口-设置-历史-启用 edH4 0 #f))
(show "(编辑器-视口-设置-历史-启用 edH4 0 #f)" (编辑器-文档-历史启用? edH5 0))
(show "(编辑器-视口-清空-历史 edH5 0)" (编辑器-文档-撤销-深度 (编辑器-视口-清空-历史 edH5 0) 0))

(printf "\n================ 3. 文档名 ================\n")

;; 编辑器-文档-设置-名称 : 显式文档标识 + 新名字（不影响历史/焦点）。
(define edN (编辑器-文档-设置-名称 ed0 0 "新名字.txt"))
(show "(编辑器-文档-设置-名称 ed0 0 \"新名字.txt\")" (编辑器-文档-名称 edN 0))

(printf "\n================ 4. 链接（可跨文档同步视口） ================\n")

;; 准备：文档 0 开两个视口（一个显式链接 '同屏），另开文档 1 也加入 '同屏。
(define L0 (编辑器-打开 (string-join (map number->string (range 40)) "\n") 5 16))
(define-values (L1 视口L1) (编辑器-添加-视口 L0 0 5 16 #:焦点? #f))
(define L2 (编辑器-视口-设置-链接 L1 视口L1 '同屏))          ; 只给 视口L1 设链接
(define-values (L3 文档L2) (编辑器-打开-文档 L2 (string-join (map (lambda (i) (format "doc2-~a" i)) (range 40)) "\n") 5 16 #:名称 "other" #:焦点? #f))
(define 视口L2 (编辑器-文档-视口 L3 文档L2))
(define L4 (编辑器-视口-设置-链接 L3 视口L2 '同屏))          ; 跨文档同链接

(show "编辑器-视口-链接 视口L1 / 视口L2"
      (list (编辑器-视口-链接 L4 视口L1) (编辑器-视口-链接 L4 视口L2)))
(show "编辑器-链接-列表（全部非 #f 链接名）" (编辑器-链接列表 L4))

;; 编辑器-设置-链接 : 焦点视口设链接（#:对齐? 默认 #t = 立即对齐；#:从 指定参考成员）。
;; 编辑器-视口-设置-链接 : 显式视口版。这里演示 #:对齐? #f（只设成员，不动视口）。
(define L5 (编辑器-设置-链接 (编辑器-焦点-视口 L4 0) '顶排 #:对齐? #f))
(show "编辑器-设置-链接 … '顶排 #:对齐? #f → 焦点链接" (编辑器-链接 L5))

;; 编辑器-链接-视口列表 : 组替换语义（列表外旧成员退出，列表内不存在的标识报错）。
;;   把焦点视口 0、视口L1、视口L2 三个一起放进 '同屏。
(define L6 (编辑器-链接-视口列表 L4 '同屏 (list 0 视口L1 视口L2)))
(show "编辑器-链接-视口列表 L4 '同屏 (list 0 视口L1 视口L2) → 成员链接"
      (list (编辑器-视口-链接 L6 0) (编辑器-视口-链接 L6 视口L1) (编辑器-视口-链接 L6 视口L2)))

;; 对齐：把 '同屏 组对齐到参考成员。先让参考（焦点视口 0）滚到第 20 行，
;; 再 #:从 0 对齐 → 其余成员按视口的镜像规则跟过去。
(define L7 (编辑器-视口-跳转 L6 0 (位置 20 0)))
(define L8 (编辑器-视口-设置-链接 L7 0 '同屏 #:对齐? #t #:从 0))
(show "对齐后：焦点(参考) / 视口L1(同文档) / 视口L2(跨文档) 顶行"
      (list (编辑器-视口-顶行 L8 0) (编辑器-视口-顶行 L8 视口L1) (编辑器-视口-顶行 L8 视口L2)))

;; 编辑器-视口-解除链接 : 把某视口退出链接组（设 #f）。
(define L9 (编辑器-视口-解除链接 L8 视口L2))
(show "(编辑器-视口-解除链接 L8 视口L2)" (编辑器-视口-链接 L9 视口L2))

(printf "\ndemo/3-属性与链接.rkt 运行结束。\n")
