#lang racket

;;; ============================================================================
;;; core-chinese/demo/1-构造与查询.rkt —— editor 层用法演示（中性面）
;;; ============================================================================
;;;
;;;   racket core-chinese/demo/1-构造与查询.rkt
;;;
;;; 覆盖 core-chinese/editor.rkt 的**中性面**（platform/neutral.rkt）：
;;;   构造 / 生命周期 · 只读查询 · 光标与尺寸 · 点算子 · 文本解析 · 属性读 · 账本查询
;;;
;;; 写法约定：每个 API 一行注释（签名 / 设计 / 用法）+ 一句 (show 表达式 值)。
;;; 「焦点糖」：省略 视口标识 的 编辑器-* 等价于显式传焦点视口；
;;; 「显式」：编辑器-视口-* / 编辑器-文档-* 必须给 视口标识 / 文档标识。
;;;
;;; 名字的寻址轴：
;;;   编辑器-视口-*   按 视口标识（视图状态 / 视图命令）
;;;   编辑器-文档-*   按 文档标识（文档级读 / 写 / 账本）
;;;   编辑器-*        焦点糖（读 / 写焦点视口）

(require "../core-chinese/editor.rkt"   ; 编辑器-*（平台面）
         "../core-chinese/api.rkt")     ; 位置 / 选区 / 编辑-描述 / 片段 / 屏幕 …

(define (show 表达式 值)
  (printf "~a\n    => ~s\n" 表达式 值))

(printf "\n================ 0. 构造 / 生命周期 ================\n")

;; 编辑器-打开 : 文本 [高度 24] [宽度 80] → 编辑器
;;   #:名称 文档名；#:历史? 是否记账本（文档策略位）；#:行号? 首视口是否显示行号。
(define ed0 (编辑器-打开 "hello\nworld" 2 20 #:名称 "a.txt" #:历史? #t #:行号? #f))
(show "(编辑器-打开 \"hello\\nworld\" 2 20 #:名称 \"a.txt\")" ed0)

;; 编辑器-打开-文档 : 编辑器 文本 [高度] [宽度] → (values 编辑器 文档标识)
;;   #:焦点? 默认 #f（**不抢焦点**，适合后台开缓冲）；#:名称 / #:历史? / #:行号? 同上。
(define-values (ed1 文档B) (编辑器-打开-文档 ed0 "BBB" #:名称 "b.txt" #:焦点? #f))
(show "(编辑器-打开-文档 ed0 \"BBB\" #:焦点? #f)  文档标识" 文档B)
(show "编辑器-文档-数量 ed1" (编辑器-文档-数量 ed1))

;; 编辑器-添加-视口 : 编辑器 文档标识 [高度] [宽度] [位置] → (values 编辑器 视口标识)
;;   #:同步 '自由|'跟随（该视口的显示策略）；#:焦点? 默认不抢；#:链接 视口同步链接名；#:行号?。
(define-values (ed2 视口1) (编辑器-添加-视口 ed1 0 3 10 (位置 0 0)
                                          #:同步 '跟随 #:焦点? #f #:链接 '同屏))
(show "(编辑器-添加-视口 ed1 0 3 10 (位置 0 0) #:同步 '跟随 #:链接 '同屏)  视口标识" 视口1)
(show "编辑器-视口-数量 ed2" (编辑器-视口-数量 ed2))

;; 编辑器-焦点-视口 / 编辑器-焦点-文档 : 只改焦点，不改内容；文档版选该文档第一个视口。
(define ed3 (编辑器-焦点-视口 ed2 视口1))
(show "(编辑器-焦点-视口 ed2 视口1)  焦点" (编辑器-焦点 ed3))
(define ed4 (编辑器-焦点-文档 ed3 0))
(show "(编辑器-焦点-文档 ed3 0)  焦点" (编辑器-焦点 ed4))

;; 编辑器-关闭-视口 : 关掉一个视口；若关的是焦点，焦点落到剩余第一个（可能 #f）。
(define ed5 (编辑器-关闭-视口 ed4 视口1))
(show "(编辑器-关闭-视口 ed4 视口1)  视口数量" (编辑器-视口-数量 ed5))

;; 编辑器-关闭-文档 : 关掉一个文档及其所有视口；焦点自动重定位。
(define ed6 (编辑器-关闭-文档 ed5 文档B))
(show "(编辑器-关闭-文档 ed5 文档B)  文档数量" (编辑器-文档-数量 ed6))

(printf "\n================ 1. 查询（文档 / 视口 / 链接） ================\n")

;; 编辑器? : 谓词；编辑器-文档列表 / 编辑器-视口列表 / 编辑器-焦点 : 只读投影。
(show "(编辑器? ed0)" (编辑器? ed0))
(show "(编辑器-文档列表 ed2)  每个 文档-条目" (编辑器-文档列表 ed2))
(show "(编辑器-视口列表 ed2)  每个 视口" (编辑器-视口列表 ed2))
(show "(编辑器-焦点 ed2)  焦点视口标识" (编辑器-焦点 ed2))
(show "(编辑器-文档-标识 ed2)  焦点文档标识" (编辑器-文档-标识 ed2))

;; 文档-条目-标识 / 文档-条目-名称 : 从 文档-条目 取字段（文档条目 = 标识·名称·文档·历史·记录?）。
(define 条目0 (car (编辑器-文档列表 ed2)))
(show "(文档-条目-标识 条目0)" (文档-条目-标识 条目0))
(show "(文档-条目-名称 条目0)" (文档-条目-名称 条目0))

;; 视口-标识 / 视口-同步 : 从 视口 取字段（视口 = 标识·窗口·同步·链接）。
(define 视口值0 (car (编辑器-视口列表 ed2)))
(show "(视口-标识 视口值0)" (视口-标识 视口值0))
(show "(视口-同步 视口值0)" (视口-同步 视口值0))

;; 编辑器-文档 : 文档标识 → 文档值；编辑器-文档-缓冲 / 编辑器-文档-属性集 : 文档的文本 / 标注部分。
;; 省略 文档标识 = 焦点文档。
(show "(编辑器-文档 ed2 0)" (编辑器-文档 ed2 0))
(show "(编辑器-文档-缓冲 ed2 0)" (编辑器-文档-缓冲 ed2 0))
(show "(编辑器-文档-属性集 ed2 0)" (编辑器-文档-属性集 ed2 0))
(show "(编辑器-文档-名称 ed2 0)" (编辑器-文档-名称 ed2 0))

;; 编辑器-视口-文档-标识 : 视口 → 属主文档标识。
(show "(编辑器-视口-文档-标识 ed2 0)" (编辑器-视口-文档-标识 ed2 0))

;; 编辑器-文档-视口 : 文档 → 它第一个视口标识（没有 → #f）。
(show "(编辑器-文档-视口 ed2 0)" (编辑器-文档-视口 ed2 0))

;; 编辑器-视口-缓冲 / 编辑器-视口-文档 : 按视口直取 缓冲 / 文档（省一次 文档-标识 往返）。
(show "(编辑器-视口-缓冲 ed2 0)" (编辑器-视口-缓冲 ed2 0))
(show "(编辑器-视口-文档 ed2 0)" (编辑器-视口-文档 ed2 0))

;; 编辑器-视口-同步 / 编辑器-同步 : 显式 / 焦点 视口的同步策略（'自由 | '跟随）。
(show "(编辑器-视口-同步 ed2 视口1)" (编辑器-视口-同步 ed2 视口1))
(show "(编辑器-同步 ed2)" (编辑器-同步 ed2))

;; 编辑器-视口-链接 / 编辑器-链接 / 编辑器-链接列表 : 单个视口链接名 / 焦点链接 / 全部非 #f 链接。
(show "(编辑器-视口-链接 ed2 视口1)" (编辑器-视口-链接 ed2 视口1))
(show "(编辑器-链接 ed2)" (编辑器-链接 ed2))
(show "(编辑器-链接列表 ed2)" (编辑器-链接列表 ed2))

(printf "\n================ 2. 光标 / 选区 / 尺寸 / 滚动 ================\n")

;; 编辑器-位置 : 焦点视口主选区头部（光标）。编辑器-视口-位置 : 显式视口。
(show "(编辑器-位置 ed2)" (编辑器-位置 ed2))
(show "(编辑器-视口-位置 ed2 0)" (编辑器-视口-位置 ed2 0))

;; 编辑器-主选区 : 给主选区**值**（不靠位置比较）；...-索引 : 给下标。
(show "(编辑器-主选区 ed2)" (编辑器-主选区 ed2))
(show "(编辑器-主选区-索引 ed2)" (编辑器-主选区-索引 ed2))
(show "(编辑器-视口-主选区 ed2 0)" (编辑器-视口-主选区 ed2 0))
(show "(编辑器-视口-主选区-索引 ed2 0)" (编辑器-视口-主选区-索引 ed2 0))

;; 编辑器-窗口 : 视口的窗口值（文档 ⊕ 选区集 ⊕ 滚动/尺寸）。编辑器-选区列表 / 编辑器-选区集。
(show "(编辑器-窗口 ed2)" (编辑器-窗口 ed2))
(show "(编辑器-选区列表 ed2)" (编辑器-选区列表 ed2))
(show "(编辑器-选区集 ed2)" (编辑器-选区集 ed2))
(show "(编辑器-选区集-名称 ed2)" (编辑器-选区集-名称 ed2))
(show "(编辑器-视口-选区集-名称 ed2 0)" (编辑器-视口-选区集-名称 ed2 0))

;; 尺寸 / 滚动 / 模式 / 行号（都是视图态，只读口）。
(show "(编辑器-高度 ed2) (编辑器-宽度 ed2)" (list (编辑器-高度 ed2) (编辑器-宽度 ed2)))
(show "(编辑器-视口-高度 ed2 0) (编辑器-视口-宽度 ed2 0)"
      (list (编辑器-视口-高度 ed2 0) (编辑器-视口-宽度 ed2 0)))
(show "(编辑器-顶行 ed2) (编辑器-左列 ed2) (编辑器-顶段 ed2)"
      (list (编辑器-顶行 ed2) (编辑器-左列 ed2) (编辑器-顶段 ed2)))
(show "(编辑器-模式 ed2) (编辑器-行号? ed2)"
      (list (编辑器-模式 ed2) (编辑器-行号? ed2)))
(show "(编辑器-视口-左列 ed2 0) (编辑器-视口-顶段 ed2 0)"
      (list (编辑器-视口-左列 ed2 0) (编辑器-视口-顶段 ed2 0)))

(printf "\n================ 3. 点算子（编辑器 级：不碰 缓冲/窗口） ================\n")

;; 左右/行首/末尾需要 缓冲；上下需要 窗口。编辑器-* 是焦点糖，编辑器-视口-* 显式。
(show "(编辑器-位置-右 ed2 (位置 0 0))" (编辑器-位置-右 ed2 (位置 0 0)))
(show "(编辑器-位置-左 ed2 (位置 1 0))" (编辑器-位置-左 ed2 (位置 1 0)))
(show "(编辑器-位置-行首 ed2 (位置 1 3))" (编辑器-位置-行首 ed2 (位置 1 3)))
(show "(编辑器-位置-末尾 ed2 (位置 0 0))" (编辑器-位置-末尾 ed2 (位置 0 0)))
(show "(编辑器-位置-上 ed2 (位置 1 0))" (编辑器-位置-上 ed2 (位置 1 0)))
(show "(编辑器-位置-下 ed2 (位置 0 0))" (编辑器-位置-下 ed2 (位置 0 0)))
(show "(编辑器-视口-位置-右 ed2 0 (位置 0 0))" (编辑器-视口-位置-右 ed2 0 (位置 0 0)))
(show "(编辑器-视口-位置-左 ed2 0 (位置 1 0))" (编辑器-视口-位置-左 ed2 0 (位置 1 0)))
(show "(编辑器-视口-位置-行首 ed2 0 (位置 1 3))" (编辑器-视口-位置-行首 ed2 0 (位置 1 3)))
(show "(编辑器-视口-位置-末尾 ed2 0 (位置 0 0))" (编辑器-视口-位置-末尾 ed2 0 (位置 0 0)))
(show "(编辑器-视口-位置-上 ed2 0 (位置 1 0))" (编辑器-视口-位置-上 ed2 0 (位置 1 0)))
(show "(编辑器-视口-位置-下 ed2 0 (位置 0 0))" (编辑器-视口-位置-下 ed2 0 (位置 0 0)))

(printf "\n================ 4. 文本 / 解析 / 版本戳 ================\n")

;; 编辑器-文档->字符串 / ->行列表 : 整体文本（含换行）/ 行列表。
(show "(编辑器-文档->字符串 ed2 0)" (编辑器-文档->字符串 ed2 0))
(show "(编辑器-文档->行列表 ed2 0)" (编辑器-文档->行列表 ed2 0))

;; 行级读：行-数量 / 行-引用 / 行-长度（按 文档标识 + 行号）。
(show "(编辑器-文档-行-数量 ed2 0)" (编辑器-文档-行-数量 ed2 0))
(show "(编辑器-文档-行-引用 ed2 0 1)" (编辑器-文档-行-引用 ed2 0 1))
(show "(编辑器-文档-行-长度 ed2 0 1)" (编辑器-文档-行-长度 ed2 0 1))

;; 位置 ↔ 偏移：位置是 (行,列)；偏移是 content->string 里的字符下标。夹紧把位置收进合法域。
(show "(编辑器-文档-位置->偏移 ed2 0 (位置 1 3))" (编辑器-文档-位置->偏移 ed2 0 (位置 1 3)))
(show "(编辑器-文档-偏移->位置 ed2 0 9)" (编辑器-文档-偏移->位置 ed2 0 9))
(show "(编辑器-文档-夹紧-位置 ed2 0 (位置 9 9))" (编辑器-文档-夹紧-位置 ed2 0 (位置 9 9)))

;; 范围文本：半开 [起点,末尾)。
(show "(编辑器-文档-范围-文本 ed2 0 (位置 0 0) (位置 0 5))"
      (编辑器-文档-范围-文本 ed2 0 (位置 0 0) (位置 0 5)))

;; 版本戳：文本版本（=缓冲版本戳，只文本变更 +1）/ 属性版本（只属性变更 +1）。
;; 相等判断：内容-相等? 判「文本本身是否同一」；属性集-相等? 判「标注是否同一」。
(show "(编辑器-文档-文本-版本戳 ed2 0)" (编辑器-文档-文本-版本戳 ed2 0))
(show "(编辑器-文档-属性-版本戳 ed2 0)" (编辑器-文档-属性-版本戳 ed2 0))
(show "(编辑器-文档-内容-相等? ed2 0 0)" (编辑器-文档-内容-相等? ed2 0 0))
(show "(编辑器-文档-属性集-相等? ed2 0 0)" (编辑器-文档-属性集-相等? ed2 0 0))

(printf "\n================ 5. 属性读（先写一段属性） ================\n")

;; 先用属性写造点数据（详见 demo/3-属性与链接.rkt）：
;;   安装-属性 键 行 c0 c1 值 —— 把第 0 行 [0,5) 的 键 设为 值。
;; 属性写走“变更命令”，返回 (values 编辑器 变更-报告)。
(define-values (edA _报告A) (编辑器-文档-安装-属性 ed2 0 '外观 0 0 5 (hash '外观 '关键字)))
(show "(编辑器-文档-安装-属性 ed2 0 '外观 0 0 5 …)" edA)

;; 属性集-在 : 某位置的整行属性段。属性集-片段集 : 整行 (list 起点 末尾 属性hash)。
;; 属性集-键-片段集 : 只取某键的 (list 起点 末尾 值)。
(show "(编辑器-文档-属性集-在 edA 0 (位置 0 2))" (编辑器-文档-属性集-在 edA 0 (位置 0 2)))
(show "(编辑器-文档-属性集-片段集 edA 0 0)" (编辑器-文档-属性集-片段集 edA 0 0))
(show "(编辑器-文档-属性集-键-片段集 edA 0 0 '外观)"
      (编辑器-文档-属性集-键-片段集 edA 0 0 '外观))

(printf "\n================ 6. 账本查询 ================\n")

;; 省略 文档标识 = 焦点文档。可撤销/可重做 / 撤销深度 / 重做深度。
(show "(编辑器-文档-可撤销? edA 0)" (编辑器-文档-可撤销? edA 0))
(show "(编辑器-文档-可重做? edA 0)" (编辑器-文档-可重做? edA 0))
(show "(编辑器-文档-撤销-深度 edA 0)" (编辑器-文档-撤销-深度 edA 0))
(show "(编辑器-文档-重做-深度 edA 0)" (编辑器-文档-重做-深度 edA 0))

(printf "\n1-构造与查询.rkt 运行结束。\n")
