(define by-name
  (for/hash ([e (in-list c-lib-entries)])
    (values (c-lib-entry-name e) e)))

(define (c-lib-entry-for name)
  (and (string? name) (hash-ref by-name name #f)))

(define c-lib-names
  (remove-duplicates
   (for/list ([e (in-list c-lib-entries)]) (c-lib-entry-name e))))

(define c-lib-headers
  (remove-duplicates
   (for/list ([e (in-list c-lib-entries)]
              #:when (c-lib-entry-header e))
     (c-lib-entry-header e))))

;; 常见 C / POSIX / Linux 头文件；补全时只在 #include <...> / #include "..." 内使用。
