#lang racket

;;; edit-tui/lang/c/data/lib.rkt —— 常见 C / POSIX / Unix / Linux lib 索引
;;;
;;; 只用于补全和 man 缺失时的兜底；完整文档优先 `man`。
;;; 不是完整的 libc 符号表，也不保证每个签名与当前系统 ABI 完全一致。

(require racket/list)

(provide (struct-out c-lib-entry)
         c-lib-entries
         c-lib-entry-for
         c-lib-names
         c-lib-headers
         c-standard-headers
         c-header-names)

(struct c-lib-entry
  (name        ; string
   kind        ; 'function | 'macro | 'type
   header      ; "stdio.h" | #f
   signature   ; string | #f
   summary     ; string | #f
   section)    ; 2 | 3 | 7 | #f：man 优先节
  #:transparent)

(define (fn name header sig summary [section 3])
  (c-lib-entry name 'function header sig summary section))
(define (sys name header sig summary)
  (c-lib-entry name 'function header sig summary 2))
(define (macro name header sig summary [section #f])
  (c-lib-entry name 'macro header sig summary section))
(define (type name header sig summary [section #f])
  (c-lib-entry name 'type header sig summary section))

