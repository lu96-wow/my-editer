#lang racket

(require "../atom/point.rkt" "../atom/edit.rkt" "../atom/selection.rkt" "../atom/selection-set.rkt"
         "../doc/buffer.rkt" "../doc/document.rkt"
         "window.rkt" "layout.rkt" rackunit)

;;; viewport/rebase.rkt —— 编辑后 视口 的重新基准（窗口同步机制的唯一实现）
;;;
;;; 编辑一次 = 一串 编辑-描述（施加顺序）。每个 窗口 的**所有选区**都要过这串 描述：
;;;   自由    每个选区端点随文本映射（落在被删区间 → 吸附删除起点），视口钉住不动。
;;;   主导  每个选区**坍缩到 头部 并前进到插入之后**（编辑列表-映射-位置 的零宽语义），
;;;           再 确保 主选区 可见 —— 这是「编辑者」的光标行为。
;;;   跟随  选区 + 视口锚点复制自 主导，再按自己几何 确保。
;;;
;;; 关键次序：主导 必须**先 确保-位置 定稿**，follower 再复制它。
;;;
;;; 注意：本层换的是 窗口 里的 **文档**（文本 + 标注）；标注的移动在
;;; 文档-施加-变更 里已经完成，这里只重定位光标/视口。

(provide 重基准-自由 重基准-主导 重基准-跟随 重基准-跟随-视口)

;; w : 待调整的 窗口；d* : 编辑后的新 文档；描述集 : (listof 编辑-描述) 施加顺序
(define (重基准-自由 w d* 描述集)
  (struct-copy 窗口 w [文档 d*] [选区集 (选区集-映射-编辑 (窗口-选区集 w) 描述集)]))

;; 编辑者语义：选区坍缩到「经过全部 描述 之后」的 头部，再 确保 主选区 可见。
(define (重基准-主导 w d* 描述集)
  (窗口-确保-位置
   (struct-copy 窗口 w [文档 d*] [选区集 (选区集-推进-主导 (窗口-选区集 w) 描述集)])))

;; w : 待调整的 窗口；主导 : 编辑视图的最终 窗口（已 确保）
(define (重基准-跟随 w 主导)
  (窗口-确保-位置
   (struct-copy 窗口 w
     [文档 (窗口-文档 主导)]
     [选区集    (窗口-选区集 主导)]
     [顶行 (窗口-顶行 主导)]
     [左列 (窗口-左列 主导)]
     [顶段  (窗口-顶段 主导)])))

;; 视口镜像（**不**重新 确保）：把 主导 的 文档 / 选区 / 视口锚点字面复制过来。
;;
;; 用于「以某 窗口 为准」的同步（编辑器-视口-滚动 / 编辑器-视口-跟随）：主导 可能
;; 特意把光标滚出视口（窗口-滚动 只管视口、不管光标），若再按 follower 自己的光标
;; 确保，视口会被拉回一行 / 多行，导致同步窗口与被同步窗口错位。
(define (重基准-跟随-视口 w 主导)
  (struct-copy 窗口 w
    [文档 (窗口-文档 主导)]
    [选区集 (窗口-选区集 主导)]
    [顶行 (窗口-顶行 主导)]
    [左列 (窗口-左列 主导)]
    [顶段  (窗口-顶段 主导)]))

;;; ---------- 测试（纯 窗口 级）----------

(module+ test
  (define d0 (文档-打开 "l0\nl1\nl2\nl3\nl4\nl5\nl6"))

  ;; 自由：光标随编辑右移（插入点之后的字符）
  (define d-ins (编辑-描述 (位置 0 0) (位置 0 0) "XX"))
  (define d1 (let-values ([(d _) (文档-施加-编辑 d0 d-ins)]) d))
  (define wf (窗口-设置-位置 (窗口-打开 d0 3 10) (位置 0 1)))
  (check-equal? (窗口-位置 (重基准-自由 wf d1 (list d-ins))) (位置 0 3))

  ;; 自由：光标落在被删区间 → 吸附删除起点
  (define d-del (编辑-描述 (位置 0 0) (位置 1 0) ""))
  (define d2 (let-values ([(d _) (文档-施加-编辑 d0 d-del)]) d))
  (check-equal? (窗口-位置 (重基准-自由 (窗口-设置-位置 (窗口-打开 d0 3 10) (位置 0 1)) d2 (list d-del)))
                (位置 0 0))

  ;; 自由：多选区各自映射
  (define wm (窗口-设置-选区列表 (窗口-打开 d0 3 10)
                                    (list (选区 (位置 0 1) (位置 0 1))
                                          (选区 (位置 1 0) (位置 1 0)))))
  (check-equal? (map 选区-头部 (窗口-选区列表 (重基准-自由 wm d1 (list d-ins))))
                (list (位置 0 3) (位置 1 0)))

  ;; 主导：光标前进到插入之后
  (check-equal? (窗口-位置 (重基准-主导 (窗口-打开 d1 3 10) d1 (list d-ins)))
                (位置 0 2))

  ;; 跟随：几何不同的视图，镜像 主导 选区后按自己几何 确保
  (define 主导 (窗口-设置-位置 (窗口-打开 d1 5 10) (位置 4 0)))
  (define 主导* (窗口-确保-位置 主导))
  (define foll (重基准-跟随 (窗口-打开 d1 2 10) 主导*))
  (check-equal? (窗口-位置 foll) (窗口-位置 主导*))
  (check-true (<= (窗口-顶行 foll) 4
                  (+ (窗口-顶行 foll) (sub1 (窗口-高度 foll)))))
  (check-eq? (窗口-文档 foll) (窗口-文档 主导*))

  ;; 跟随-视口：字面镜像视口，**不**按 follower 光标重新 确保
  ;; （主导 特意把光标滚出视口时，视口不得被拉回）
  (define lv (struct-copy 窗口 (窗口-确保-位置 (窗口-打开 d1 3 10))
                          [顶行 4]))
  (define fv* (重基准-跟随-视口 (窗口-打开 d1 3 10) lv))
  (check-equal? (窗口-顶行 fv*) 4)
  (check-equal? (窗口-位置 fv*) (窗口-位置 lv))          ; 选区仍复制自 主导
  (check-equal? (窗口-顶段 fv*) (窗口-顶段 lv))
  (check-equal? (窗口-左列 fv*) (窗口-左列 lv))

  (displayln "rebase.rkt: all tests passed"))
