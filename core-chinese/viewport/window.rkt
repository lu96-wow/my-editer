#lang racket

(require "../atom/point.rkt" "../atom/selection.rkt" "../atom/selection-set.rkt"
         "../doc/buffer.rkt" "../doc/document.rkt"
         "../atom/width.rkt" racket/list rackunit)

;;; viewport/window.rkt —— 视口：缓冲 引用 + 本窗口的选区集合 + 滚动位置 + 尺寸
;;;
;;; 缓冲 是文档（无光标）；窗口 是「怎么看它」，持有自己的**选区集合**（至少一个）。
;;; 一个 缓冲 可被多个 窗口 绑定，各有独立选区。
;;;
;;;   选区集         : 选区集   本窗口的选区（名字 + 区间集 + 主导，已规范化）
;;;   空选区 (anchor=head) 就是普通光标；单个 窗口 至少含一个空选区。
;;;
;;; 本层是**纯视图**：导航、滚动、尺寸。**编辑不在这里**。
;;; 坐标：位置 的 列 是**字符索引**；顶行/顶段/左列 是**显示列/行**。

(provide
 (struct-out 窗口)
 窗口-打开
 窗口-缓冲
 窗口-设置-文档
 窗口-设置-行号
 检查模式
 吸附-左列
 位置-左
 位置-右
 位置-行首
 位置-末尾
 窗口-位置
 窗口-选区列表
 窗口-主选区
 窗口-主选区-索引
 窗口-选区集-名称
 窗口-安装-选区集
 窗口-清空-选区集
 窗口-映射-选区列表
 窗口-映射-主选区
 窗口-设置-文档
 窗口-设置-位置
 窗口-设置-选区列表
 窗口-添加-选区列表
 窗口-移除-选区列表
 窗口-添加-选区
 窗口-移除-选区
 窗口-设置-主选区
 窗口-设置-主选区-索引
 窗口-选区-成员?
 窗口-映射-位置列表
 窗口-夹紧-选区列表
 窗口-设置-模式
 窗口-设置-顶行
 窗口-设置-左列
 窗口-设置-顶段
 窗口-设置-尺寸
 窗口-垂直滚动
 窗口-水平滚动
 窗口-左
 窗口-右
 窗口-行首
 窗口-末尾)

(struct 窗口
  (文档      ; 文档（缓冲 ⊕ 属性集）
   选区集         ; 选区集：名字 + 区间集 + 主导
   模式          ; '裁剪|'折行
   顶行      ; nat        裁剪/折行：顶部所在 缓冲 行
   左列      ; nat        裁剪：水平滚动列（折行 下被布局忽略；值保留，切回 裁剪 再生效）
   顶段       ; nat        折行：顶部行的第几个折行段（裁剪 下被布局忽略；同上）
   高度        ; nat        可见行数
   宽度         ; nat        可见列数（含行号栏）
   行号?) ; boolean   是否在左侧留行号栏（宽度由 布局 派生，不存）
  #:transparent)

(define (窗口-打开 d [高度 24] [宽度 80])
  (unless (and (exact-nonnegative-integer? 高度) (>= 高度 1))
    (error '窗口-打开 "height 必须 ≥ 1，得到 ~a" 高度))
  (unless (and (exact-nonnegative-integer? 宽度) (>= 宽度 1))
    (error '窗口-打开 "width 必须 ≥ 1，得到 ~a" 宽度))
  (窗口 d (选区集-打开 #f (list (插入符 (位置 0 0))) 0) '裁剪 0 0 0 高度 宽度 #f))

;; 行号栏开关（视图装饰）。宽度不由本层存：由 布局 按当前视口的行号上界现算。
(define (窗口-设置-行号 w 开?) (struct-copy 窗口 w [行号? (and 开? #t)]))

;; 本视图看的**文本**（属性在 窗口-文档 的 属性集 里）。
(define (窗口-缓冲 w) (文档-缓冲 (窗口-文档 w)))

;;; ---------- 光标 / 选区（都是 选区集 的派生视图）----------

(define (窗口-选区列表 w) (选区集-选区列表 (窗口-选区集 w)))
(define (窗口-主选区-索引 w) (选区集-主导-索引 (窗口-选区集 w)))
;; 显式 主选区：给选区**值**，不靠位置比较。
(define (窗口-主选区 w) (选区集-主导 (窗口-选区集 w)))
(define (窗口-位置 w) (选区-位置 (窗口-主选区 w)))

;; 名字（“命名区间组”）；#f = 匿名。
(define (窗口-选区集-名称 w) (选区集-名称 (窗口-选区集 w)))
;; 安装一个现成的选区集（含名字）。
(define (窗口-安装-选区集 w g) (struct-copy 窗口 w [选区集 g]))
;; 清除：收敛为单个选区（主导），名字丢弃。**何时调用由上层决定**。
(define (窗口-清空-选区集 w) (struct-copy 窗口 w [选区集 (选区集-清空 (窗口-选区集 w))]))

(define (夹紧-选区 b s)
  (选区 (缓冲-夹紧-位置 b (选区-锚点 s))
             (缓冲-夹紧-位置 b (选区-头部 s))))

;; 把现有选区夹进 缓冲 合法域并规范化；主导 追到它合并后的那个。
(define (窗口-夹紧-选区列表 w)
  (define b (窗口-缓冲 w))
  (define g (窗口-选区集 w))
  (define sels (map (lambda (s) (夹紧-选区 b s)) (选区集-选区列表 g)))
  (struct-copy 窗口 w [选区集 (选区集-打开 (选区集-名称 g) sels (选区集-主导-索引 g))]))

(define (窗口-设置-文档 w d)
  (窗口-夹紧-选区列表 (struct-copy 窗口 w [文档 d])))

;; 设成单个空选区（程序面「把光标放这」的语义）；名字清空。
(define (窗口-设置-位置 w p)
  (define q (缓冲-夹紧-位置 (窗口-缓冲 w) p))
  (struct-copy 窗口 w [选区集 (选区集-打开 #f (list (插入符 q)) 0)]))

;; 设一组选区；主选区 按输入下标选，规范化后追到合并结果；名字保持。
(define (窗口-设置-选区列表 w sels [主选区-索引 0])
  (unless (pair? sels) (error '窗口-设置-选区列表 "至少一个选区"))
  (define b (窗口-缓冲 w))
  (define 已夹紧 (map (lambda (s) (夹紧-选区 b s)) sels))
  (struct-copy 窗口 w [选区集 (选区集-打开 (窗口-选区集-名称 w) 已夹紧 主选区-索引)]))

;; 对每个选区施加 f（选区 → 选区），再规范化；主选区 保持。
(define (窗口-映射-选区列表 w f)
  (窗口-设置-选区列表 w (map f (窗口-选区列表 w)) (窗口-主选区-索引 w)))

;; 只对 主选区 施加 f（选区 → 选区）；其余不动，主选区 保持。
(define (窗口-映射-主选区 w f)
  (define i (窗口-主选区-索引 w))
  (define sels (窗口-选区列表 w))
  (窗口-设置-选区列表 w (list-set sels i (f (list-ref sels i))) i))

;; 增/删单个选区；设置-主选区 让集合中等于 s 的选区成为 主选区（不在集合中则原样）。
(define (窗口-添加-选区 w s #:主选区? [主选区? #f])
  (窗口-添加-选区列表 w (list s) #:主选区? 主选区?))
(define (窗口-移除-选区 w s)
  (窗口-移除-选区列表 w (list s)))
(define (窗口-设置-主选区 w s)
  (struct-copy 窗口 w [选区集 (选区集-安装-主导 (窗口-选区集 w) s)]))

;; 直接设 主选区 下标；越界夹回合法域（选区集非空）。
(define (窗口-设置-主选区-索引 w i)
  (struct-copy 窗口 w [选区集 (选区集-打开 (窗口-选区集-名称 w) (窗口-选区列表 w) i)]))
(define (窗口-选区-成员? w s)
  (and (member s (窗口-选区列表 w)) #t))

;; 对每个选区的 头部 施加 f（位置 → 位置），坍缩成空选区；主选区 跟随。
;; 导航（方向键）用它：一次动所有光标。
(define (窗口-映射-位置列表 w f)
  (define 已移动 (for/list ([s (in-list (窗口-选区列表 w))])
                  (插入符 (f (选区-头部 s)))))
  (struct-copy 窗口 w [选区集 (选区集-打开 (窗口-选区集-名称 w) 已移动 (窗口-主选区-索引 w))]))

;; 并集：把 sels 加进现有选区集（规范化）；主选区 默认保持，#:主选区? #t 则让新加的成为 主选区。
;; 空集是恒等（不改变 主选区）。
(define (窗口-添加-选区列表 w sels #:主选区? [主选区? #f])
  (cond
    [(null? sels) w]
    [else
     (struct-copy 窗口 w
       [选区集 (选区集-打开 (窗口-选区集-名称 w)
                          (append (窗口-选区列表 w) sels)
                          (if 主选区? (length (窗口-选区列表 w)) (窗口-主选区-索引 w)))])]))

;; 差集：从现有选区集去掉与 丢弃 相等的项；主选区 尽量保持，删空则原样。
(define (窗口-移除-选区列表 w 丢弃)
  (define 旧 (窗口-选区列表 w))
  (define 主导 (窗口-主选区 w))
  (define 保留 (remove* 丢弃 旧))
  (cond
    [(null? 保留) w]
    [else
     (define 索引 (or (for/first ([s (in-list 保留)] [i (in-naturals)]
                                 #:when (equal? s 主导)) i)
                     0))
     (struct-copy 窗口 w [选区集 (选区集-打开 (窗口-选区集-名称 w) 保留 索引)])]))

;;; ---------- 视图状态 ----------

(define (检查模式 报错者 m)
  (unless (memq m '(裁剪 折行))
    (error 报错者 "mode 必须是 'clip 或 'wrap，得到 ~a" m)))

(define (窗口-设置-模式 w m) (检查模式 '窗口-设置-模式 m) (struct-copy 窗口 w [模式 m]))
(define (窗口-设置-顶行 w n)  (struct-copy 窗口 w [顶行 (max 0 n)]))
(define (窗口-设置-顶段 w n) (struct-copy 窗口 w [顶段 (max 0 n)]))
(define (窗口-设置-尺寸 w 高度 宽度)
  (struct-copy 窗口 w [高度 (max 1 高度)] [宽度 (max 1 宽度)]))

(define (窗口-垂直滚动 w 增量)
  (struct-copy 窗口 w [顶行 (max 0 (+ (窗口-顶行 w) 增量))]))

;; 水平滚动的参考行 = 顶行（左列 作用于整个可见区，顶行是代表）。
(define (左-引用-文本 w)
  (define b (窗口-缓冲 w))
  (define n (缓冲-行-数量 b))
  (缓冲-行-引用 b (max 0 (min (窗口-顶行 w) (sub1 n)))))

;; 把显示列吸附到字符起点：落在宽字符右半会画出半格空白。
;; **不夹到行尾** —— 超过行宽的列原样保留（「滚过短行尾部」是合法状态）。
(define (吸附-左列 文本 列)
  (if (<= 列 (字符串-显示-宽度 文本))
      (吸附-显示列-前向 文本 列)
      列))

(define (窗口-设置-左列 w n)
  (struct-copy 窗口 w [左列 (吸附-左列 (左-引用-文本 w) (max 0 n))]))
(define (窗口-水平滚动 w 增量)
  (窗口-设置-左列 w (+ (窗口-左列 w) 增量)))

;;; ---------- 点运动（纯）----------
;; 只依赖文本的四种：字符/行级。上/下 需要视口几何，见 viewport/layout.rkt。

(define (位置-左 b p)
  (define l (位置-行 p)) (define o (位置-列 p))
  (cond
    [(> o 0) (位置 l (sub1 o))]
    [(> l 0) (位置 (sub1 l) (string-length (缓冲-行-引用 b (sub1 l))))]
    [else p]))

(define (位置-右 b p)
  (define l (位置-行 p)) (define o (位置-列 p))
  (define n (缓冲-行-数量 b))
  (cond
    [(< o (string-length (缓冲-行-引用 b l))) (位置 l (add1 o))]
    [(< l (sub1 n)) (位置 (add1 l) 0)]
    [else p]))

(define (位置-行首 p) (位置 (位置-行 p) 0))
(define (位置-末尾 b p)
  (位置 (位置-行 p) (string-length (缓冲-行-引用 b (位置-行 p)))))

;;; ---------- 导航（每个选区各走一步）----------
;; 方向键把每个选区坍缩到 头部 后移动；新位置去重/合并。

(define (窗口-左 w)  (窗口-映射-位置列表 w (lambda (p) (位置-左  (窗口-缓冲 w) p))))
(define (窗口-右 w) (窗口-映射-位置列表 w (lambda (p) (位置-右 (窗口-缓冲 w) p))))
(define (窗口-行首 w)  (窗口-映射-位置列表 w 位置-行首))
(define (窗口-末尾 w)   (窗口-映射-位置列表 w (lambda (p) (位置-末尾 (窗口-缓冲 w) p))))

;;; ---------- 测试 ----------

(module+ test
  (define d (文档-打开 "a\nb\nc\nd\ne"))
  (define b (文档-缓冲 d))
  (define w (窗口-打开 d 2 10))

  ;; 构造：缓冲 引用 + 初始光标 / 滚动 / 尺寸
  (check-equal? (窗口-缓冲 w) b)
  (check-equal? (窗口-位置 w) (位置 0 0))
  (check-equal? (窗口-模式 w) '裁剪)
  (check-equal? (窗口-顶行 w) 0)
  (check-equal? (窗口-顶段 w) 0)
  (check-equal? (窗口-高度 w) 2)
  (check-equal? (窗口-宽度 w) 10)

  ;; 光标夹紧
  (check-equal? (窗口-位置 (窗口-设置-位置 w (位置 3 99))) (位置 3 1))
  (check-equal? (窗口-位置 (窗口-设置-位置 w (位置 99 0))) (位置 4 0))
  (check-equal? (窗口-位置 (窗口-设置-文档 w (文档-打开 ""))) (位置 0 0))

  ;; 导航
  (check-equal? (窗口-位置 (窗口-右 w)) (位置 0 1))
  (check-equal? (窗口-位置 (窗口-左 (窗口-右 w))) (位置 0 0))
  (check-equal? (窗口-位置 (窗口-左 w)) (位置 0 0))          ; 行首不动
  (check-equal? (窗口-位置 (窗口-右 (窗口-末尾 w))) (位置 1 0))
  (check-equal? (窗口-位置 (窗口-左 (窗口-右 (窗口-末尾 w)))) (位置 0 1))
  (check-equal? (窗口-位置 (窗口-行首 (窗口-设置-位置 w (位置 2 0)))) (位置 2 0))

  ;; 多选区：设一组，导航一次动全部
  (define ws (窗口-打开 (文档-打开 "abcde\nfghij") 3 10))
  (define wm (窗口-设置-选区列表 ws (list (选区 (位置 0 0) (位置 0 0))
                                             (选区 (位置 0 2) (位置 0 2)))))
  (check-equal? (length (窗口-选区列表 wm)) 2)
  (check-equal? (map 选区-头部 (窗口-选区列表 (窗口-左 wm)))
                (list (位置 0 0) (位置 0 1)))       ; 第一不动(行首)，第二左移
  (check-equal? (length (窗口-选区列表 (窗口-右 wm))) 2)  ; 两光标各右移一格

  ;; 重叠合并 / 去重；主选区 追到合并结果
  (define wo (窗口-设置-选区列表 ws (list (选区 (位置 0 0) (位置 0 2))
                                             (选区 (位置 0 1) (位置 0 3)))))
  (check-equal? (length (窗口-选区列表 wo)) 1)
  (check-equal? (call-with-values (lambda () (选区-范围 (car (窗口-选区列表 wo)))) list)
                (list (位置 0 0) (位置 0 3)))

  ;; 主选区 边界不歧义：[0,2) 与 插入符(2) 并存时 primary=caret；首尾相接的两个区间取后者
  (check-equal? (窗口-主选区 (窗口-设置-选区列表 ws (list (选区 (位置 0 0) (位置 0 2))
                                                                (插入符 (位置 0 2))) 1))
                (插入符 (位置 0 2)))
  (check-equal? (窗口-主选区 (窗口-设置-选区列表 ws (list (选区 (位置 0 0) (位置 0 2))
                                                                (选区 (位置 0 2) (位置 0 4))) 1))
                (选区 (位置 0 2) (位置 0 4)))

  ;; 滚动 / 尺寸
  (check-equal? (窗口-顶行 (窗口-垂直滚动 w 2)) 2)
  (check-equal? (窗口-顶行 (窗口-垂直滚动 w -5)) 0)
  (check-equal? (窗口-顶行 (窗口-设置-顶行 w 4)) 4)
  (check-equal? (窗口-左列 (窗口-水平滚动 (窗口-设置-左列 w 3) 2)) 5)
  (check-equal? (窗口-设置-尺寸 w 30 100) (窗口-设置-尺寸 w 30 100))
  (check-equal? (窗口-模式 (窗口-设置-模式 w '折行)) '折行)
  (check-equal? (窗口-顶段 (窗口-设置-顶段 w 3)) 3)

  ;; 水平吸附：宽字符右半 → 下一字符起点；滚过行尾保留
  (define wd (窗口-打开 (文档-打开 "中abc") 2 4))
  (check-equal? (窗口-左列 (窗口-设置-左列 wd 0)) 0)
  (check-equal? (窗口-左列 (窗口-设置-左列 wd 1)) 2)
  (check-equal? (窗口-左列 (窗口-设置-左列 wd 2)) 2)
  (check-equal? (窗口-左列 (窗口-设置-左列 wd 99)) 99)

  ;; 未知 模式 → 报错
  (check-exn exn:fail? (lambda () (窗口-设置-模式 w 'bad)))

  ;; —— 点运动原语 ——
  (define bp (缓冲-打开 "ab\ncd"))
  (check-equal? (位置-右 bp (位置 0 1)) (位置 0 2))
  (check-equal? (位置-右 bp (位置 0 2)) (位置 1 0))
  (check-equal? (位置-左 bp (位置 1 0)) (位置 0 2))
  (check-equal? (位置-行首 (位置 1 1)) (位置 1 0))
  (check-equal? (位置-末尾 bp (位置 0 0)) (位置 0 2))

  ;; —— 显式 主选区 + map 算子 ——
  (define wp0 (窗口-设置-选区列表 ws (list (插入符 (位置 0 0)) (插入符 (位置 0 2))) 1))
  (check-equal? (窗口-主选区 wp0) (插入符 (位置 0 2)))
  (check-equal? (窗口-主选区-索引 wp0) 1)
  (check-true (窗口-选区-成员? wp0 (插入符 (位置 0 0))))
  ;; map 全部（两端移动）；主选区 保持
  (define wp1 (窗口-映射-选区列表 wp0
                 (lambda (s) (选区-映射-两端 (lambda (p) (位置-右 (窗口-缓冲 wp0) p)) s))))
  (check-equal? (map 选区-头部 (窗口-选区列表 wp1)) (list (位置 0 1) (位置 0 3)))
  (check-equal? (窗口-主选区 wp1) (插入符 (位置 0 3)))
  ;; map 主选区：只动主选区，其余不动
  (define wp2 (窗口-映射-主选区 wp0
                 (lambda (s) (选区-映射-头部 (lambda (p) (位置-右 (窗口-缓冲 wp0) p)) s))))
  (check-equal? (选区-头部 (list-ref (窗口-选区列表 wp2) 0)) (位置 0 0))
  (check-equal? (选区-头部 (窗口-主选区 wp2)) (位置 0 3))
  ;; 增 / 删 / 设 主选区
  (check-equal? (length (窗口-选区列表 (窗口-添加-选区 wp0 (插入符 (位置 0 4))))) 3)
  (check-equal? (窗口-主选区 (窗口-添加-选区 wp0 (插入符 (位置 0 4)) #:主选区? #t)) (插入符 (位置 0 4)))
  (check-equal? (length (窗口-选区列表 (窗口-移除-选区 wp0 (插入符 (位置 0 0))))) 1)
  (check-equal? (窗口-主选区 (窗口-设置-主选区 wp0 (插入符 (位置 0 0)))) (插入符 (位置 0 0)))

  ;; 名字（命名区间组）：设组 / 读名 / 清除；map 保留名字
  (define wg (窗口-安装-选区集 w (选区集-打开 'g (list (插入符 (位置 0 0)) (插入符 (位置 0 2))) 0)))
  (check-equal? (窗口-选区集-名称 wg) 'g)
  (check-equal? (窗口-选区集-名称 (窗口-映射-位置列表 wg (lambda (p) p))) 'g)
  (check-equal? (窗口-选区集-名称 (窗口-设置-位置 wg (位置 0 1))) #f)
  (define wgc (窗口-清空-选区集 wg))
  (check-false (窗口-选区集-名称 wgc))
  (check-equal? (length (窗口-选区列表 wgc)) 1)
  (check-equal? (窗口-主选区 wgc) (插入符 (位置 0 0)))

  (displayln "window.rkt: all tests passed"))
