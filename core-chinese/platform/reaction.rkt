#lang racket

(require "../atom/point.rkt" "../atom/edit.rkt"
         "../doc/buffer.rkt" "../doc/document.rkt"
         "../viewport/window.rkt" "../viewport/layout.rkt" "../viewport/rebase.rkt" "../viewport/mirror.rkt"
         "../unit/history.rkt"
         "state.rkt" "write.rkt" rackunit)

;;; platform/reaction.rkt —— 显示语义：内容变更后，视图怎么反应
;;;
;;; 内容面（编辑器-施加-变更）只管「换 文档 引用」，光标一个都不碰。
;;; 本层是唯一的**显示语义**层，全部是 编辑器 -> 编辑器 的纯函数，三选一：
;;;
;;;   编辑器-夹紧-视口列表   none   字面不动，只把光标/视口夹回合法域（可能文本变小）
;;;   编辑器-映射-视口列表     map    每个同 文档 视口 各自把光标映射过这次编辑（不滚屏）
;;;   编辑器-主导-视口   主导 指定 视口 推进到插入后 + 确保；同 链接 成员按视口镜像
;;;                               （可跨 文档），同 文档 其余 自由 映射 / 跟随 复制最终视口
;;;
;;; 另有 编辑器-主导-窗口：用户导航用——把一个 视口 的 窗口 定稿，同 链接 成员按视口镜像，
;;; 同 文档 的 跟随 镜像它（不含内容变更）。
;;;
;;; 契约：`自由` / `跟随` 显示语义**只在同一 文档 的 视口 之间**发生；跨 文档 只走
;;; `链接` 的视口镜像（不改对方的 文档 / 选区）。主导 必须**先 确保 定稿**，follower 再复制
;;; （否则差一行）。
;;;
;;; 本层只依赖 platform 的数据/写原语（state.rkt / write.rkt）；不认识中性接口/程序面/用户面。

(provide 编辑器-夹紧-视口列表
         编辑器-映射-视口列表
         编辑器-主导-视口
         编辑器-主导-窗口
         编辑器-对齐-链接)

;; none：只夹紧（换 文档 引用时已保留旧光标；文本可能变小 → 必须夹回合法域）。
(define (编辑器-夹紧-视口列表 ed d)
  (for/fold ([e ed]) ([v (in-list (编辑器-视口列表 ed))])
    (if (eq? d (视口-文档 v))
        (let ([w (视口-窗口 v)])
          (编辑器-安装-视口 e (视口-标识 v)
                           (窗口-夹紧-视口 (窗口-夹紧-选区列表 w))))
        e)))

;; map：每个同 文档 视口 各自 自由 映射所有选区（按施加顺序折叠过整批 描述集）；
;; 不设 主导、不滚屏、不复制视口。
(define (编辑器-映射-视口列表 ed d 描述集)
  (for/fold ([e ed]) ([v (in-list (编辑器-视口列表 ed))])
    (if (eq? d (视口-文档 v))
        (编辑器-安装-视口 e (视口-标识 v) (重基准-自由 (视口-窗口 v) d 描述集))
        e)))

;; 主导：视口标识 的选区推进到插入后 + 确保；同 链接 成员按视口镜像（可跨 文档），
;; 同 文档 其余 自由 映射 / 跟随 镜像。
(define (编辑器-主导-视口 ed 视口标识 d 描述集)
  (define v (编辑器-视口-引用 ed 视口标识))
  (define 链接 (视口-链接 v))
  (define editing (重基准-主导 (视口-窗口 v) d 描述集))
  ;; 同 文档 的 视口 先把光标映射过这次编辑；跨 文档 的保持原样。
  (define (基础-窗口 x)
    (cond
      [(not (eq? d (视口-文档 x))) (视口-窗口 x)]
      [(eq? (视口-同步 x) '跟随) (重基准-跟随 (视口-窗口 x) editing)]
      [else (重基准-自由 (视口-窗口 x) d 描述集)]))
  (for/fold ([e ed]) ([x (in-list (编辑器-视口列表 ed))])
    (cond
      [(= 视口标识 (视口-标识 x)) (编辑器-安装-视口 e 视口标识 editing)]
      ;; 同 链接（可跨 文档）：只镜像视口，不改成员自己的 文档
      [(and 链接 (eq? 链接 (视口-链接 x)))
       (编辑器-安装-视口 e (视口-标识 x) (镜像-窗口 editing (基础-窗口 x)))]
      [(not (eq? d (视口-文档 x))) e]
      [else (编辑器-安装-视口 e (视口-标识 x) (基础-窗口 x))])))

;; 用户导航：把 视口标识 的 窗口 定稿；同 链接 成员按视口镜像，同 文档 的 跟随 视口 镜像它。
(define (编辑器-主导-窗口 ed 视口标识 w*)
  (define v (编辑器-视口-引用 ed 视口标识))
  (define d (视口-文档 v))
  (define 链接 (视口-链接 v))
  (for/fold ([e ed]) ([x (in-list (编辑器-视口列表 ed))])
    (cond
      [(= 视口标识 (视口-标识 x)) (编辑器-安装-视口 e 视口标识 w*)]
      [(and 链接 (eq? 链接 (视口-链接 x)))
       ;; 同 文档 的成员带上 主导 的选区；跨 文档 的只镜像视口。
       ;; 字面镜像视口（不重新 确保）：否则 主导 把光标滚出视口时会被拉回。
       (define w0 (视口-窗口 x))
       (define 基础 (if (and (eq? d (视口-文档 x)) (eq? (视口-同步 x) '跟随))
                        (重基准-跟随-视口 w0 w*)
                        w0))
       (编辑器-安装-视口 e (视口-标识 x) (镜像-窗口 w* 基础))]
      [(and (eq? d (视口-文档 x)) (eq? (视口-同步 x) '跟随))
       (编辑器-安装-视口 e (视口-标识 x) (重基准-跟随-视口 (视口-窗口 x) w*))]
      [else e])))

;; 把一个 链接 组对齐到**参考成员**：`从`（若在组内）→ 焦点 视口（若在组内）→ 组内第一个成员。
;; 参考成员自身不动，其余成员按 镜像-窗口 投参考窗口视口。空组 / #f → 恒等。
(define (编辑器-对齐-链接 ed 链接 [从 #f])
  (define 成员集 (if 链接
                      (filter (lambda (v) (eq? 链接 (视口-链接 v))) (编辑器-视口列表 ed))
                      '()))
  (define (成员? 视口标识) (and 视口标识 (for/or ([v (in-list 成员集)]) (= 视口标识 (视口-标识 v)))))
  (define 焦点 (编辑器-焦点 ed))
  (define 来源-标识 (cond [(成员? 从) 从]
                       [(成员? 焦点) 焦点]
                       [(pair? 成员集) (视口-标识 (car 成员集))]
                       [else #f]))
  (cond
    [(not 来源-标识) ed]
    [else
     (define w (视口-窗口 (编辑器-视口-引用 ed 来源-标识)))
     (for/fold ([e ed]) ([x (in-list 成员集)])
       (if (= 来源-标识 (视口-标识 x))
           e
           (编辑器-安装-视口 e (视口-标识 x) (镜像-窗口 w (视口-窗口 x)))))]))

;;; ---------- 测试（只经机制层造 编辑器） ----------

(module+ test
  ;; 造一个单 文档 单 视口 的 编辑器；再加一个 视口（可指定 同步）
  (define (mk 文本 h w)
    (define d (文档-打开 文本))
    (编辑器 (list (文档-条目 0 "s" d (历史-空) #t))
            (list (视口 0 (窗口-打开 d h w) '自由 #f)) 0 1 1))
  (define (添加-视口 ed h w p 同步)
    (define d (文档-条目-文档 (编辑器-文档-条目 ed 0)))
    (struct-copy 编辑器 ed
      [视口列表 (append (编辑器-视口列表 ed)
                     (list (视口 (编辑器-下一个-视口 ed)
                                 (窗口-设置-位置 (窗口-打开 d h w) p) 同步 #f)))]
      [下一个-视口 (add1 (编辑器-下一个-视口 ed))]))
  (define (vp ed 视口标识) (窗口-位置 (视口-窗口 (编辑器-视口-引用 ed 视口标识))))
  (define (vtl ed 视口标识) (窗口-顶行 (视口-窗口 (编辑器-视口-引用 ed 视口标识))))
  (define (vd ed 文档标识) (文档-条目-文档 (编辑器-文档-条目 ed 文档标识)))

  (define d-ins (编辑-描述 (位置 0 0) (位置 0 0) "XY"))

  ;; none：光标字面不动（只夹紧，不映射）
  (define n0 (添加-视口 (mk "l0\nl1\nl2\nl3" 3 10) 3 10 (位置 0 1) '自由))
  (define n1 (let-values ([(e _) (编辑器-施加-编辑 n0 0 d-ins #:受信? #t)]) (编辑器-夹紧-视口列表 e (vd e 0))))
  (check-equal? (vp n1 1) (位置 0 1))                     ; 不随编辑移动

  ;; map：光标随编辑右移，视口不动
  (define m0 (添加-视口 (mk "l0\nl1\nl2\nl3" 3 10) 3 10 (位置 0 1) '自由))
  (define m1 (let-values ([(e d*) (编辑器-施加-编辑 m0 0 d-ins #:受信? #t)])
               (编辑器-映射-视口列表 e (vd e 0) (list d*))))
  (check-equal? (vp m1 1) (位置 0 3))                     ; (0,1) 映射到 (0,3)
  (check-equal? (vtl m1 1) 0)

  ;; 主导：主导 推进，跟随 镜像
  (define g0 (添加-视口 (mk "l0\nl1\nl2\nl3\nl4\nl5" 3 10) 3 10 (位置 0 0) '跟随))
  (define-values (g3 dg) (编辑器-施加-编辑 g0 0 (编辑-描述 (位置 0 0) (位置 0 0) "XY") #:受信? #t))
  (define g4 (编辑器-主导-视口 g3 0 (vd g3 0) (list dg)))
  (check-equal? (vp g4 0) (位置 0 2))
  (check-equal? (vp g4 1) (位置 0 2))
  (check-eq? (vd g4 0) (窗口-文档 (视口-窗口 (编辑器-视口-引用 g4 1))))

  (displayln "reaction.rkt: all tests passed"))
