;;; ---------- 投影 ----------
;;; 外观-提供者 : 编辑器 文档标识 行 → (listof (list 起点 末尾 外观))；投影时按需调用。
;;; 内部适配成 视口 的 缓冲 级 提供者，应用不见 缓冲。

(define (空外观提供者 _ed _bid _line) '())

;; 把属性 缓冲 的某个 键 物化成 外观-提供者。
(define (属性集-提供者 键)
  (lambda (ed 文档标识 行) (编辑器-文档-属性集-键-片段集 ed 文档标识 行 键)))

(define (编辑器-视口->屏幕 ed 视口标识 [外观-提供者 空外观提供者])
  (define 文档标识 (编辑器-视口-文档-标识 ed 视口标识))
  (窗口->屏幕 (视口-窗口 (编辑器-视口-引用 ed 视口标识))
                  (lambda (_b 行) (外观-提供者 ed 文档标识 行))))
(define (编辑器->屏幕 ed [外观-提供者 空外观提供者])
  (编辑器-视口->屏幕 ed (编辑器-焦点 ed) 外观-提供者))

;;; ---------- 点算子（编辑器 级：位置只认 位置，缓冲 由 文档标识/视口标识 解析） ----------
;;; 应用写导航/扩选时不再需要拿 缓冲 / 窗口。

(define (编辑器-位置-左 ed p) (位置-左 (编辑器-文档-缓冲 ed (已聚焦-文档标识 ed)) p))
(define (编辑器-视口-位置-左 ed 视口标识 p) (位置-左 (编辑器-视口-缓冲 ed 视口标识) p))
(define (编辑器-位置-右 ed p) (位置-右 (编辑器-文档-缓冲 ed (已聚焦-文档标识 ed)) p))
(define (编辑器-视口-位置-右 ed 视口标识 p) (位置-右 (编辑器-视口-缓冲 ed 视口标识) p))
(define (编辑器-位置-行首 ed p) (位置-行首 p))
(define (编辑器-视口-位置-行首 ed 视口标识 p) (位置-行首 p))
(define (编辑器-位置-末尾 ed p) (位置-末尾 (编辑器-文档-缓冲 ed (已聚焦-文档标识 ed)) p))
(define (编辑器-视口-位置-末尾 ed 视口标识 p) (位置-末尾 (编辑器-视口-缓冲 ed 视口标识) p))
(define (编辑器-位置-上 ed p) (位置-上 (编辑器-窗口 ed) p))
(define (编辑器-视口-位置-上 ed 视口标识 p) (位置-上 (编辑器-视口-窗口 ed 视口标识) p))
(define (编辑器-位置-下 ed p) (位置-下 (编辑器-窗口 ed) p))
(define (编辑器-视口-位置-下 ed 视口标识 p) (位置-下 (编辑器-视口-窗口 ed 视口标识) p))

;;; ---------- 文本 / 解析 / 属性读（按 文档-标识） ----------
;;; 文档标识 缺省 = 焦点 缓冲；只有「ed 后只有一个参数」的读口能安全缺省
;;; （带 payload 时，位置缺省会与 payload 抢参数，故必须显式给 文档标识）。

(define (编辑器-文档->字符串 ed [文档标识 (已聚焦-文档标识 ed)]) (缓冲->字符串 (编辑器-文档-缓冲 ed 文档标识)))
(define (编辑器-文档->行列表 ed [文档标识 (已聚焦-文档标识 ed)]) (缓冲->行列表 (编辑器-文档-缓冲 ed 文档标识)))
(define (编辑器-文档-行-数量 ed [文档标识 (已聚焦-文档标识 ed)]) (缓冲-行-数量 (编辑器-文档-缓冲 ed 文档标识)))
(define (编辑器-文档-行-引用 ed 文档标识 i) (缓冲-行-引用 (编辑器-文档-缓冲 ed 文档标识) i))
(define (编辑器-文档-行-长度 ed 文档标识 i) (缓冲-行-长度 (编辑器-文档-缓冲 ed 文档标识) i))
(define (编辑器-文档-夹紧-位置 ed 文档标识 p) (缓冲-夹紧-位置 (编辑器-文档-缓冲 ed 文档标识) p))
(define (编辑器-文档-位置->偏移 ed 文档标识 p) (缓冲-位置->偏移 (编辑器-文档-缓冲 ed 文档标识) p))
(define (编辑器-文档-偏移->位置 ed 文档标识 偏移) (缓冲-偏移->位置 (编辑器-文档-缓冲 ed 文档标识) 偏移))
(define (编辑器-文档-范围-文本 ed 文档标识 s e) (缓冲-范围-文本 (编辑器-文档-缓冲 ed 文档标识) s e))
(define (编辑器-文档-文本-版本戳 ed [文档标识 (已聚焦-文档标识 ed)]) (缓冲-版本戳 (编辑器-文档-缓冲 ed 文档标识)))
(define (编辑器-文档-属性-版本戳 ed [文档标识 (已聚焦-文档标识 ed)]) (文档-属性-版本戳 (编辑器-文档 ed 文档标识)))
(define (编辑器-文档-内容-相等? ed b1 b2)
  (缓冲-内容-相等? (编辑器-文档-缓冲 ed b1) (编辑器-文档-缓冲 ed b2)))
(define (编辑器-文档-属性集-相等? ed b1 b2)
  (文档-属性集-相等? (编辑器-文档 ed b1) (编辑器-文档 ed b2)))
(define (编辑器-文档-属性集-在 ed 文档标识 p) (文档-属性集-在 (编辑器-文档 ed 文档标识) p))
(define (编辑器-文档-属性集-片段集 ed 文档标识 行) (文档-属性集-片段集 (编辑器-文档 ed 文档标识) 行))
(define (编辑器-文档-属性集-键-片段集 ed 文档标识 行 键)
  (文档-属性集-键-片段集 (编辑器-文档 ed 文档标识) 行 键))

;;; ---------- 账本查询 ----------

(define (编辑器-文档-可撤销? ed [文档标识 (已聚焦-文档标识 ed)])
  (历史-可撤销? (文档-条目-历史 (编辑器-文档-条目 ed 文档标识))))
(define (编辑器-文档-可重做? ed [文档标识 (已聚焦-文档标识 ed)])
  (历史-可重做? (文档-条目-历史 (编辑器-文档-条目 ed 文档标识))))
(define (编辑器-文档-撤销-深度 ed [文档标识 (已聚焦-文档标识 ed)])
  (历史-撤销-深度 (文档-条目-历史 (编辑器-文档-条目 ed 文档标识))))
(define (编辑器-文档-重做-深度 ed [文档标识 (已聚焦-文档标识 ed)])
  (历史-重做-深度 (文档-条目-历史 (编辑器-文档-条目 ed 文档标识))))

;;; ---------- 测试：中性面 ----------

(module+ test
  (require rackunit "write.rkt")
  (define e0 (编辑器-打开 "hello\nworld" 2 10))
  ;; 文本 / 位置解析 / 投影
  (check-equal? (编辑器-文档->字符串 e0 0) "hello\nworld")
  (check-equal? (编辑器-文档-行-长度 e0 0 0) 5)
  (check-equal? (编辑器-文档-夹紧-位置 e0 0 (位置 9 9)) (位置 1 5))
  (check-equal? (编辑器-文档-位置->偏移 e0 0 (位置 1 0)) 6)
  (check-equal? (编辑器-位置 e0) (位置 0 0))
  (check-true (屏幕? (编辑器->屏幕 e0)))
  ;; 显式 视口 只读：模式 / 左列 / 顶段（不经过焦点）
  (check-equal? (编辑器-视口-模式 e0 0) '裁剪)
  (check-equal? (编辑器-视口-左列 e0 0) 0)
  (check-equal? (编辑器-视口-顶段 e0 0) 0)
  ;; 焦点 视口 读糖（与 编辑器-视口-* 镜像）
  (check-equal? (编辑器-模式 e0) '裁剪)
  (check-equal? (编辑器-左列 e0) 0)
  (check-equal? (编辑器-顶段 e0) 0)
  (check-false (编辑器-文档-可撤销? e0 0))

  ;; 变化计数：读口（并发/合并的版本戳）
  (check-equal? (编辑器-文档-文本-版本戳 e0 0) 0)
  (check-equal? (编辑器-文档-属性-版本戳 e0 0) 0)
  (check-true (编辑器-文档-内容-相等? e0 0 0))
  (define-values (et _dt) (编辑器-施加-编辑 e0 0 (编辑-描述 (位置 0 0) (位置 0 0) "X")))
  (check-equal? (编辑器-文档-文本-版本戳 et 0) 1)
  ;; 属性写只涨标注版本，不涨文本版本
  (define-values (et2 _et2r)
    (编辑器-施加-变更 et 0 (属性集->变更 (list (属性-设置 (位置 0 0) (位置 0 1) 'x #t)))))
  (check-equal? (编辑器-文档-文本-版本戳 et2 0) 1)     ; 文本版本不变
  (check-equal? (编辑器-文档-属性-版本戳 et2 0) 1)       ; 标注版本 +1

  ;; 属性读：任意 键 的段；只读 是保留 键
  (define-values (pr _prr)
    (编辑器-施加-变更 e0 0 (属性集->变更 (list (属性-设置 (位置 0 0) (位置 0 5) 只读键 #t)))))
  (check-equal? (编辑器-文档-属性集-片段集 pr 0 0) (list (list 0 5 (hash 只读键 #t))))
  (check-equal? (编辑器-文档-属性集-键-片段集 pr 0 0 只读键) (list (list 0 5 #t)))

  ;; 整体属性读 + 属性等价（与 编辑器-文档-缓冲 / 编辑器-文档-内容-相等? 对称）
  (check-equal? (编辑器-文档-属性集 pr) (文档-属性集 (编辑器-文档 pr 0)))
  (check-true (编辑器-文档-属性集-相等? pr 0 0))
  (check-true (编辑器-文档-属性集-相等? e0 0 0))

  ;; #:焦点? #f：后台开 缓冲 不抢焦点
  (define-values (e1 _bid) (编辑器-打开-文档 e0 "BBB" #:名称 "b" #:焦点? #f))
  (check-equal? (编辑器-文档-标识 e1) 0)
  (check-equal? (编辑器-文档-数量 e1) 2)

  ;; 文档 → 第一个 视口 标识（没有 视口 → #f）
  (check-equal? (编辑器-文档-视口 e0 0) 0)
  (define-values (e2v bid2v) (编辑器-打开-文档 e0 "CCC" #:名称 "c" #:焦点? #f))
  (define v2v (编辑器-文档-视口 e2v bid2v))
  (check-equal? (编辑器-视口-文档-标识 e2v v2v) bid2v)
  (check-false (编辑器-文档-视口 (编辑器-关闭-视口 e2v v2v) bid2v))
  ;; #:链接 类型校验
  (check-exn exn:fail? (lambda () (编辑器-添加-视口 e0 0 2 10 #:链接 "bad")))

  ;; 行号栏：投影到 屏幕 的前缀 片段（外观 '行号），光标右移 g 列
  (define eln (编辑器-打开 "a\nb\nc" 3 10 #:行号? #t))
  (check-equal? (屏幕-屏行 (编辑器-视口->屏幕 eln 0) 0)
                (list (片段 0 "1 " (hash '外观 '行号)) (片段 2 "a" #f)))
  (check-equal? (屏幕-光标-列 (编辑器-视口->屏幕 eln 0)) 2)

  ;; 结构变换：设置-视口-缓冲 换属主、不改文本、不动焦点
  (define n1 (编辑器-设置-视口-文档 e1 0 1))
  (check-equal? (编辑器-视口-文档-标识 n1 0) 1)
  (check-equal? (编辑器-文档->字符串 n1 1) "BBB")

  ;; 焦点 糖默认 文档标识：编辑器-文档-缓冲 / 账本查询省略 文档标识 时看焦点 缓冲
  (check-eq? (编辑器-文档-缓冲 e0) (编辑器-文档-缓冲 e0 0))
  (check-equal? (编辑器-文档->字符串 e0) (编辑器-文档->字符串 e0 0))
  (check-equal? (编辑器-文档-行-数量 e0) (编辑器-文档-行-数量 e0 0))
  (check-false (编辑器-文档-可撤销? e0))
  ;; 按 视口 直取 缓冲（省一次 文档-标识 往返）
  (check-eq? (编辑器-视口-缓冲 e0 0) (编辑器-文档-缓冲 e0 0))
  ;; 主选区 下标读口（焦点 / 指定 视口）
  (check-equal? (编辑器-主选区-索引 e0) 0)
  (check-equal? (编辑器-视口-主选区-索引 e0 0) 0)

  ;; 点算子（编辑器 级：不碰 缓冲/窗口）
  (check-equal? (编辑器-位置-右 e0 (位置 0 0)) (位置 0 1))
  (check-equal? (编辑器-位置-左 e0 (位置 1 0)) (位置 0 5))
  (check-equal? (编辑器-位置-末尾 e0 (位置 0 0)) (位置 0 5))
  (check-equal? (编辑器-位置-上 e0 (位置 1 0)) (位置 0 0))
  (check-equal? (编辑器-位置-下 e0 (位置 0 0)) (位置 1 0))

  ;; 属性 缓冲 物化成 提供者：编辑器->屏幕 直接读，无需 缓冲
  (define-values (pa _par)
    (编辑器-施加-变更 e0 0 (属性集->变更 (list (属性-设置 (位置 0 0) (位置 0 5) '外观 (hash '外观 '关键字))))))
  (check-equal? (屏幕-屏行 (编辑器->屏幕 pa (属性集-提供者 '外观)) 0)
                (list (片段 0 "hello" (hash '外观 '关键字))))
  (check-equal? (屏幕-屏行 (编辑器->屏幕 pa) 0)
                (list (片段 0 "hello" #f)))

  (displayln "editor.rkt: all tests passed"))
