;;; ---------- 构造 / 生命周期 ----------
(define (编辑器-打开 文本 [高度 24] [宽度 80]
                     #:名称 [名称 "*scratch*"] #:历史? [历史? #t]
                     #:行号? [行号? #f])
  (define d (文档-打开 文本))
  (define 条目 (文档-条目 0 名称 d (历史-空) 历史?))
  (编辑器 (list 条目)
          (list (视口 0 (窗口-设置-行号 (窗口-打开 d 高度 宽度) 行号?) '自由 #f))
          0 1 1))

;; 新增一个视图。#:名称 命名（默认 *scratch*）；#:焦点? 控制是否把焦点交给新视图
;; （默认**不抢**）。返回 (values 编辑器 文档-标识)。
(define (编辑器-打开-文档 ed 文本 [高度 24] [宽度 80]
                            #:名称 [名称 "*scratch*"] #:焦点? [焦点? #f]
                            #:历史? [历史? #t] #:行号? [行号? #f])
  (define 文档标识 (编辑器-下一个-文档 ed))
  (define 条目 (文档-条目 文档标识 名称 (文档-打开 文本) (历史-空) 历史?))
  (define ed1 (struct-copy 编辑器 ed
               [文档列表 (append (编辑器-文档列表 ed) (list 条目))]
               [下一个-文档 (add1 文档标识)]))
  (define-values (ed2 _vid) (编辑器-添加-视口 ed1 文档标识 高度 宽度
                                            #:焦点? 焦点? #:行号? 行号?))
  (values ed2 文档标识))

;; 新增一个视图。#:焦点? 控制是否 焦点 它（默认**不抢**）；#:链接 加入视口同步链接。
;; 返回 (values 编辑器 视口-标识)。
(define (编辑器-添加-视口 ed 文档标识 [高度 24] [宽度 80] [p (位置 0 0)]
                         #:同步 [同步 '自由] #:焦点? [焦点? #f] #:链接 [链接 #f]
                         #:行号? [行号? #f])
  (检查同步 '编辑器-添加-视口 同步)
  (检查链接 '编辑器-添加-视口 链接)
  (define 条目 (编辑器-文档-条目 ed 文档标识))
  (define 视口标识 (编辑器-下一个-视口 ed))
  (define w (窗口-夹紧-视口
             (窗口-设置-行号
              (窗口-设置-位置 (窗口-打开 (文档-条目-文档 条目) 高度 宽度) p)
              行号?)))
  (values (struct-copy 编辑器 ed
            [视口列表 (append (编辑器-视口列表 ed) (list (视口 视口标识 w 同步 链接)))]
            [焦点 (if 焦点? 视口标识 (编辑器-焦点 ed))]
            [下一个-视口 (add1 视口标识)])
          视口标识))

(define (编辑器-关闭-视口 ed 视口标识)
  (define vs (filter (lambda (v) (not (= (视口-标识 v) 视口标识))) (编辑器-视口列表 ed)))
  (define 焦点 (if (= (编辑器-焦点 ed) 视口标识)
                    (if (null? vs) #f (视口-标识 (car vs)))
                    (编辑器-焦点 ed)))
  (struct-copy 编辑器 ed [视口列表 vs] [焦点 焦点]))

(define (编辑器-关闭-文档 ed 文档标识)
  (define d (文档-条目-文档 (编辑器-文档-条目 ed 文档标识)))
  (define vs (filter (lambda (v) (not (eq? d (视口-文档 v)))) (编辑器-视口列表 ed)))
  (define bs (filter (lambda (e) (not (= (文档-条目-标识 e) 文档标识))) (编辑器-文档列表 ed)))
  (define 焦点
    (cond [(null? vs) #f]
          [(for/or ([v (in-list vs)]) (= (视口-标识 v) (编辑器-焦点 ed))) (编辑器-焦点 ed)]
          [else (视口-标识 (car vs))]))
  (struct-copy 编辑器 ed [文档列表 bs] [视口列表 vs] [焦点 焦点]))

;;; ---------- 查询 ----------

;; 焦点 视口 所属 文档 的 标识（焦点 糖的默认 文档标识）。
(define (已聚焦-文档标识 ed) (编辑器-视口-文档-标识 ed (编辑器-焦点 ed)))

(define (编辑器-文档-数量 ed) (length (编辑器-文档列表 ed)))
;; 该 文档 的默认历史策略（是否把变更记入账本）。命令可用 #:记录? 覆盖。
(define (编辑器-文档-历史启用? ed [文档标识 (已聚焦-文档标识 ed)])
  (文档-条目-记录? (编辑器-文档-条目 ed 文档标识)))
(define (编辑器-视口-历史启用? ed 视口标识)
  (文档-条目-记录? (编辑器-文档-条目 ed (编辑器-视口-文档-标识 ed 视口标识))))
(define (编辑器-视口-数量 ed) (length (编辑器-视口列表 ed)))
(define (编辑器-文档-标识 ed) (已聚焦-文档标识 ed))
;; 文档标识 省略时用焦点 视口 的 缓冲（焦点 糖）。
(define (编辑器-文档-缓冲 ed [文档标识 (已聚焦-文档标识 ed)]) (文档-缓冲 (编辑器-文档 ed 文档标识)))
(define (编辑器-文档 ed [文档标识 (已聚焦-文档标识 ed)]) (文档-条目-文档 (编辑器-文档-条目 ed 文档标识)))
(define (编辑器-文档-属性集 ed [文档标识 (已聚焦-文档标识 ed)]) (文档-属性集 (编辑器-文档 ed 文档标识)))
(define (编辑器-文档-名称 ed [文档标识 (已聚焦-文档标识 ed)]) (文档-条目-名称 (编辑器-文档-条目 ed 文档标识)))
(define (编辑器-视口-文档-标识 ed 视口标识) (取文档标识 ed (视口-文档 (编辑器-视口-引用 ed 视口标识))))
;; 某 文档 的第一个 视口 标识（没有 视口 → #f）；文档标识 缺省 = 焦点 文档。
(define (编辑器-文档-视口 ed [文档标识 (已聚焦-文档标识 ed)])
  (define v (文档的视口 ed 文档标识))
  (and v (视口-标识 v)))
(define (编辑器-视口-缓冲 ed 视口标识) (视口-缓冲 (编辑器-视口-引用 ed 视口标识)))
(define (编辑器-视口-文档 ed 视口标识) (视口-文档 (编辑器-视口-引用 ed 视口标识)))
(define (编辑器-视口-同步 ed 视口标识) (视口-同步 (编辑器-视口-引用 ed 视口标识)))
(define (编辑器-同步 ed) (编辑器-视口-同步 ed (编辑器-焦点 ed)))
;; 视口同步链接（可跨 文档）：单个 视口 的 链接 名 / 焦点 链接 / 全部 链接 名。
(define (编辑器-视口-链接 ed 视口标识) (视口-链接 (编辑器-视口-引用 ed 视口标识)))
(define (编辑器-链接 ed) (编辑器-视口-链接 ed (视口-标识 (编辑器-已聚焦-视口 ed))))
(define (编辑器-链接列表 ed) (remove-duplicates (filter values (map 视口-链接 (编辑器-视口列表 ed)))))

;; 变更-报告 的行区间是 文本集 与 属性集 的投影并集，读时现算。
(define (变更-报告-跨度 r)
  (define-values (tf tl) (编辑列表-跨度 (变更-报告-文本集 r)))
  (define-values (af al)
    (for/fold ([f #f] [l #f]) ([a (in-list (变更-报告-属性集 r))])
      (define 行 (位置-行 (属性-描述-起点 a)))
      (values (if f (min f 行) 行) (if l (max l 行) 行))))
  (values (cond [(and tf af) (min tf af)] [tf tf] [af af] [else #f])
          (cond [(and tl al) (max tl al)] [tl tl] [al al] [else #f])))
(define (变更-报告-首-行 r)
  (let-values ([(f _) (变更-报告-跨度 r)]) f))
(define (变更-报告-末-行 r)
  (let-values ([( _ l) (变更-报告-跨度 r)]) l))

(define (编辑器-焦点-视口 ed 视口标识)
  (编辑器-视口-引用 ed 视口标识)                 ; 校验存在
  (struct-copy 编辑器 ed [焦点 视口标识]))

(define (编辑器-焦点-文档 ed 文档标识)
  (define d (文档-条目-文档 (编辑器-文档-条目 ed 文档标识)))
  (define v (for/first ([v (in-list (编辑器-视口列表 ed))] #:when (eq? d (视口-文档 v))) v))
  (if v (struct-copy 编辑器 ed [焦点 (视口-标识 v)]) ed))

