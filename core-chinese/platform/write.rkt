#lang racket

(require "../atom/point.rkt" "../atom/edit.rkt" "../atom/change.rkt"
         "../doc/buffer.rkt" "../doc/document.rkt"
         "../viewport/window.rkt" "../viewport/layout.rkt"
         "../unit/history.rkt"
         "state.rkt" rackunit)

;;; platform/write.rkt —— 无策略写原语
;;;
;;; 只给同目录的 neutral/反应/program/命令 用；**不进标准入口**。
;;; 这里的东西能破坏不变量（比如只换 文档 不换别的），所以必须藏起来。
;;;
;;;   编辑器-交换-文档   换某 文档-条目 的 文档 值（entries + 同文档 视口 的引用）
;;;   编辑器-施加-变更    变更唯一漏斗（= 文档-施加-变更 + 交换）
;;;   编辑器-施加-编辑      文本单条漏斗
;;;   编辑器-施加-编辑-批 文本批量漏斗
;;;   编辑器-安装-视口        换一个 视口 的 窗口
;;;   编辑器-设置-视口-同步 / 编辑器-设置-视口-文档  视图结构变换
;;;   编辑器-安装-文档-名称
;;;   编辑器-安装-历史 / 编辑器-安装-历史-启用 / 编辑器-安装-历史-清空 / 编辑器-记录-历史
;;;
;;; 不变量（由本层维持）：任一 视口 的 窗口.文档 必是某个 文档-条目 的 文档。

(provide
 编辑器-交换-文档
 编辑器-施加-变更
 编辑器-施加-编辑
 编辑器-施加-编辑-批
 编辑器-安装-视口
 编辑器-安装-视口-链接
 编辑器-设置-视口-同步
 编辑器-设置-视口-文档
 编辑器-安装-历史
 编辑器-安装-历史-启用
 编辑器-安装-历史-清空
 编辑器-安装-文档-名称
 编辑器-记录-历史)

;;; ---------- 视图定位 ----------

;; 把指定 视口标识 的 视口 交给 f 变换（f : 视口 → 视口）；别的 视口 不动。
(define (映射-视口 ed 视口标识 f)
  (编辑器-视口-引用 ed 视口标识)                 ; 校验存在
  (struct-copy 编辑器 ed
    [视口列表 (for/list ([v (in-list (编辑器-视口列表 ed))])
             (if (= (视口-标识 v) 视口标识) (f v) v))]))

;;; ---------- 写原语（无策略） ----------

;; 换某 文档-条目 的 文档 值：entries + 同文档 视口 的 窗口.文档 一起换。
;; **不**动光标、不滚屏、不 确保（即使文本变了，光标也不映射）。
(define (编辑器-交换-文档 ed 文档标识 d*)
  (define d0 (文档-条目-文档 (编辑器-文档-条目 ed 文档标识)))
  (struct-copy 编辑器 ed
    [文档列表 (for/list ([e (in-list (编辑器-文档列表 ed))])
               (if (= (文档-条目-标识 e) 文档标识) (struct-copy 文档-条目 e [文档 d*]) e))]
    [视口列表 (for/list ([v (in-list (编辑器-视口列表 ed))])
             ;; 同属主 视口 = 窗口 指向同一个 文档 值的 视口。
             (if (eq? d0 (视口-文档 v))
                 (struct-copy 视口 v
                   [窗口 (struct-copy 窗口 (视口-窗口 v) [文档 d*])])
                 v))]))

;; 变更唯一漏斗：把 变更 施加到 文档标识 的 文档，再换引用。
;; 返回 (values 编辑器 变更-结果/#f)。**不做**任何显示决策（不映射光标）。
(define (编辑器-施加-变更 ed 文档标识 字符 #:受信? [受信? #f])
  (define d0 (文档-条目-文档 (编辑器-文档-条目 ed 文档标识)))
  (define-values (d* res) (文档-施加-变更 d0 字符 #:受信? 受信?))
  (if (not res)
      (values ed #f)
      (values (编辑器-交换-文档 ed 文档标识 d*) res)))

;; 文本单条漏斗（便利）：返回 (values 编辑器 生效描述/#f)。
(define (编辑器-施加-编辑 ed 文档标识 d #:受信? [受信? #f])
  (define-values (ed* res) (编辑器-施加-变更 ed 文档标识 (编辑列表->变更 (list d)) #:受信? 受信?))
  (define ds (if res (变更-结果-已施加-文本集 res) '()))
  (values ed* (and (pair? ds) (car ds))))

;; 文本批量漏斗：返回 (values 编辑器 生效描述集 逆)；施加顺序且平行。
(define (编辑器-施加-编辑-批 ed 文档标识 描述集 #:受信? [受信? #f])
  (define-values (ed* res) (编辑器-施加-变更 ed 文档标识 (编辑列表->变更 描述集) #:受信? 受信?))
  (if res
      (values ed* (变更-结果-已施加-文本集 res) (变更-结果-文本-逆集 res))
      (values ed '() '())))

;; 换一个 视口 的 窗口（夹紧视口）；不碰别的 视口。
(define (编辑器-安装-视口 ed 视口标识 w)
  (映射-视口 ed 视口标识 (lambda (v) (struct-copy 视口 v [窗口 (窗口-夹紧-视口 w)]))))

;; 设/清一个 视口 的视口同步链接（链接 = 符号或 #f）。
(define (编辑器-安装-视口-链接 ed 视口标识 链接)
  (检查链接 '编辑器-安装-视口-链接 链接)
  (映射-视口 ed 视口标识 (lambda (v) (struct-copy 视口 v [链接 链接]))))

;; 视图结构变换（无策略；只动指定的 视口）
(define (编辑器-设置-视口-同步 ed 视口标识 同步)
  (检查同步 '编辑器-设置-视口-同步 同步)
  (映射-视口 ed 视口标识 (lambda (v) (struct-copy 视口 v [同步 同步]))))

;; 把某个 视口 切到另一个文档（换属主；不触发任何同步）
(define (编辑器-设置-视口-文档 ed 视口标识 文档标识)
  (define d* (文档-条目-文档 (编辑器-文档-条目 ed 文档标识)))
  (映射-视口 ed 视口标识
            (lambda (v)
              (struct-copy 视口 v
                [窗口 (窗口-夹紧-视口 (窗口-设置-文档 (视口-窗口 v) d*))]))))

;;; ---------- 账本写回 ----------

;; 重放 / 撤销 都是 变更 的序列（正序施加）。
(define (编辑器-记录-历史 ed 文档标识 重放 撤销 前-位置)
  (define 条目 (编辑器-文档-条目 ed 文档标识))
  (define 条目* (struct-copy 文档-条目 条目
                  [历史 (历史-记录 (文档-条目-历史 条目) 重放 撤销 前-位置)]))
  (struct-copy 编辑器 ed
    [文档列表 (for/list ([e (in-list (编辑器-文档列表 ed))])
               (if (= (文档-条目-标识 e) 文档标识) 条目* e))]))

(define (编辑器-安装-文档-名称 ed 文档标识 名称)
  (struct-copy 编辑器 ed
    [文档列表 (for/list ([e (in-list (编辑器-文档列表 ed))])
               (if (= (文档-条目-标识 e) 文档标识) (struct-copy 文档-条目 e [名称 名称]) e))]))

(define (编辑器-安装-历史 ed 文档标识 h)
  (struct-copy 编辑器 ed
    [文档列表 (for/list ([e (in-list (编辑器-文档列表 ed))])
               (if (= (文档-条目-标识 e) 文档标识) (struct-copy 文档-条目 e [历史 h]) e))]))

;; 设某 文档 的默认历史策略（是否把变更记入账本）。
(define (编辑器-安装-历史-启用 ed 文档标识 开?)
  (struct-copy 编辑器 ed
    [文档列表 (for/list ([e (in-list (编辑器-文档列表 ed))])
               (if (= (文档-条目-标识 e) 文档标识) (struct-copy 文档-条目 e [记录? 开?]) e))]))

;; 清空某 文档 的账本（保留历史策略）。
(define (编辑器-安装-历史-清空 ed 文档标识) (编辑器-安装-历史 ed 文档标识 (历史-空)))

;;; ---------- 测试：机制原语 ----------

(module+ test
  ;; 交换-文档 不动光标
  (define d-旧 (文档-打开 "old"))
  (define e0 (编辑器 (list (文档-条目 0 "s" d-旧 (历史-空) #t))
                     (list (视口 0 (窗口-打开 d-旧 3 10) '自由 #f))
                     0 1 1))
  (define e1 (编辑器-交换-文档 e0 0 (文档-打开 "NEW")))
  (check-eq? (窗口-文档 (视口-窗口 (编辑器-视口-引用 e1 0)))
             (文档-条目-文档 (编辑器-文档-条目 e1 0)))
  (check-equal? (窗口-位置 (视口-窗口 (编辑器-视口-引用 e1 0))) (位置 0 0))

  ;; 施加-描述：内容变、光标字面不动
  (define-values (e2 d2) (编辑器-施加-编辑 e0 0 (编辑-描述 (位置 0 0) (位置 0 0) "XY")))
  (check-equal? (文档->字符串 (文档-条目-文档 (编辑器-文档-条目 e2 0))) "XYold")
  (check-equal? (窗口-位置 (视口-窗口 (编辑器-视口-引用 e2 0))) (位置 0 0))
  (check-equal? d2 (编辑-描述 (位置 0 0) (位置 0 0) "XY"))

  (displayln "write.rkt: all tests passed"))
