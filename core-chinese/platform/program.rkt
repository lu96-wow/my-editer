;;; ---------- 视口同步链接（可跨 文档）----------
;;; 链接 只是成员归属（符号名）；投影固定为「行固定 + 列按比例」，见 viewport/mirror.rkt。
;;; 设链默认**立即对齐**：参考成员 = `#:从`（若在组内）→ 焦点 视口（若在组内）→ 组内第一个。
;;; `#:对齐? #f` 只设成员，不动视口。

(define (编辑器-视口-设置-链接 ed 视口标识 链接 #:对齐? [对齐? #t] #:从 [从 #f])
  (define ed* (编辑器-安装-视口-链接 ed 视口标识 链接))
  (if 对齐? (编辑器-对齐-链接 ed* 链接 从) ed*))
(define (编辑器-设置-链接 ed 链接 #:对齐? [对齐? #t] #:从 [从 #f])
  (编辑器-视口-设置-链接 ed (视口-标识 (编辑器-已聚焦-视口 ed)) 链接 #:对齐? 对齐? #:从 从))

;; 把 vids 设成链接 名称；原来属于 名称 但不在 vids 的 视口 退出（组替换语义）。
;; vids 里出现不存在的 视口 标识 → 报错（与其它按 视口标识 的原语一致，不静默丢）。
(define (编辑器-链接-视口列表 ed 名称 vids #:对齐? [对齐? #t] #:从 [从 #f])
  (检查链接 '编辑器-链接-视口列表 名称)
  (for ([视口标识 (in-list vids)]) (编辑器-视口-引用 ed 视口标识))     ; 校验存在
  (define ed* (for/fold ([e ed]) ([v (in-list (编辑器-视口列表 ed))])
                (cond
                  [(memv (视口-标识 v) vids)  (编辑器-安装-视口-链接 e (视口-标识 v) 名称)]
                  [(eq? (视口-链接 v) 名称) (编辑器-安装-视口-链接 e (视口-标识 v) #f)]
                  [else e])))
  (if 对齐? (编辑器-对齐-链接 ed* 名称 从) ed*))
(define (编辑器-视口-解除链接 ed 视口标识) (编辑器-安装-视口-链接 ed 视口标识 #f))

