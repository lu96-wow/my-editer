;;; ---------- 编辑原语：策略全显式 ----------
;; 操作   : (or/c #f (编辑器 文档标识 选区 → (or/c #f 编辑-描述)))
;; 属性集: (or/c #f (编辑器 文档标识 (listof 编辑-描述) → (listof 属性-描述)))
;;
;; 正交策略（都是数据，不是函数身份）：
;;   #:视口       目标 视口（默认焦点 视口）
;;   #:选区  编辑上下文（默认该 视口 的选区集）
;;   #:属性集      属性计划：在文本 描述集 夹紧后求值，坐标为「文本生效之后」
;;   #:受信?   是否跳过 只读 守卫（默认 #f = 守）
;;   #:反应   'none（只夹紧）/ 'map（同文档各 视口 自由 映射）/
;;                '主导（本 视口 推进到插入后 + 确保，其余按 同步）
;;   #:记录?    是否记一步账本：'默认（跟随 文档 策略）/ #t / #f（整批记一步）
;;   #:前-位置  记账用的编辑前光标（默认该 视口 的 主选区 头部）
;; 返回 (values 编辑器 (or/c #f 变更-报告))。

;; 两条 描述 的区间是否相交（半开）
(define (描述-重叠? d1 d2)
  (and (位置<? (编辑-描述-起点 d1) (编辑-描述-末尾 d2))
       (位置<? (编辑-描述-起点 d2) (编辑-描述-末尾 d1))))

;; 两个选区的包络（方向取正向）
(define (选区-包络 a b)
  (define-values (as ae) (选区-范围 a))
  (define-values (bs be) (选区-范围 b))
  (选区 (if (位置<? bs as) bs as) (if (位置<? ae be) be ae)))

;; 多选区：对每个选区算 描述；重叠（退格/删除 超出选区，相邻就撞上）的合并成包络
;; 再重算 操作，直到 描述 两两不相交。操作 : 编辑器 文档标识 选区 → 描述/#f。
(define (合并-描述集 ed 文档标识 sels 操作)
  (define 对集
    (filter values (for/list ([s (in-list sels)])
                     (define d (操作 ed 文档标识 s))
                     (and d (cons s d)))))
  (let loop ([ps 对集])
    (cond
      [(null? ps) '()]
      [else
       (define p (car ps))
       (define 冲突 (filter (lambda (q) (描述-重叠? (cdr p) (cdr q))) (cdr ps)))
       (cond
         [(null? 冲突) (cons (cdr p) (loop (cdr ps)))]
         [else
          (define 组 (cons p 冲突))
          (define 包络 (for/fold ([h (car (car 组))]) ([g (in-list (cdr 组))])
                         (选区-包络 h (car g))))
          (define d (操作 ed 文档标识 包络))
          (loop (if d
                    (cons (cons 包络 d) (remove* 冲突 (cdr ps)))
                    (remove* 冲突 (cdr ps))))])])))

;; 命令的后半：反应 + 记账 + 报告（单个 / 批 / 属性 共用）。
;; 把命令级的 #:记录? 解析成布尔：'默认 = 跟随 文档 的历史策略。
(define (解析-记录? 报错者 e 文档标识 r)
  (case r
    [(默认) (编辑器-文档-历史启用? e 文档标识)]
    [(#t) #t]
    [(#f) #f]
    [else (error 报错者 "#:record? 必须是 'default / #t / #f，得到 ~a" r)]))

(define (编辑器-片段-变更 ed 字符 视口标识 反应 记录? 前 守卫?)
  (define 文档标识 (编辑器-视口-文档-标识 ed 视口标识))
  (define rec? (解析-记录? '编辑器-命令 ed 文档标识 记录?))
  (define-values (ed* res) (编辑器-施加-变更 ed 文档标识 字符 #:受信? (not 守卫?)))
  (cond
    [(not res) (values ed #f)]
    [else
     (define d* (编辑器-文档 ed* 文档标识))
     (define tds (变更-结果-已施加-文本集 res))
     (define ed** (case 反应
                    [(none)   (编辑器-夹紧-视口列表 ed* d*)]
                    [(map)    (编辑器-映射-视口列表 ed* d* tds)]
                    [(主导) (编辑器-主导-视口 ed* 视口标识 d* tds)]
                    [else (error '编辑器-命令 "reaction 必须是 'none / 'map / 'leader，得到 ~a" 反应)]))
     (define ed*** (if rec?
                       (编辑器-记录-历史 ed** 文档标识
                                              (list (变更-结果-重放 res))
                                              (变更-结果-撤销 res)
                                              前)
                       ed**))
     (values ed*** (变更-报告 tds (变更-结果-已施加-属性集 res)))]))

;; 给一串选区与 操作（+ 可选属性计划），算 变更 再施加。
(define (编辑器-命令 ed 操作
                        #:属性集 [属性-计划 #f]
                        #:视口 [视口标识 (视口-标识 (编辑器-已聚焦-视口 ed))]
                        #:选区 [选区 #f]
                        #:受信? [受信? #f]
                        #:反应 [反应 'none]
                        #:记录? [记录? '默认]
                        #:编辑前位置 [前-位置 #f])
  (define v (编辑器-视口-引用 ed 视口标识))
  (define 文档标识 (编辑器-视口-文档-标识 ed 视口标识))
  (define sels (or 选区 (窗口-选区列表 (视口-窗口 v))))
  (define 描述集 (if 操作 (合并-描述集 ed 文档标识 sels 操作) '()))
  (define 生效 (缓冲-夹紧-编辑-描述集 (编辑器-文档-缓冲 ed 文档标识) 描述集))
  (define 属性集 (if 属性-计划 (or (属性-计划 ed 文档标识 生效) '()) '()))
  (define 前 (or 前-位置 (选区-位置 (窗口-主选区 (视口-窗口 v)))))
  (编辑器-片段-变更 ed (变更 生效 属性集) 视口标识 反应 记录? 前 (not 受信?)))

;; 给一个已算好的 变更 直接施加。
(define (编辑器-命令-批 ed 字符
                        #:视口 [视口标识 (视口-标识 (编辑器-已聚焦-视口 ed))]
                        #:受信? [受信? #f]
                        #:反应 [反应 'none]
                        #:记录? [记录? '默认]
                        #:编辑前位置 [前-位置 #f])
  (define v (编辑器-视口-引用 ed 视口标识))
  (define 前 (or 前-位置 (选区-位置 (窗口-主选区 (视口-窗口 v)))))
  (编辑器-片段-变更 ed 字符 视口标识 反应 记录? 前 (not 受信?)))

;;; ---------- 编辑动作（编辑器 级，可传的值）----------
;;; 操作 : 编辑器 文档标识 选区 → (or/c #f 编辑-描述)。只**算** 描述，不施加；
;;; 转发给 doc 层的 缓冲 级动作（缓冲-操作-*）。编辑原语只认这一种形状。

(define (编辑-插入 文本)
  (lambda (ed 文档标识 sel) ((缓冲-操作-插入 文本) (编辑器-文档-缓冲 ed 文档标识) sel)))
(define (编辑-插入-字符 字符) (编辑-插入 (string 字符)))
(define (编辑-换行)       (编辑-插入 "\n"))
(define (编辑-退格)
  (lambda (ed 文档标识 sel) ((缓冲-操作-退格) (编辑器-文档-缓冲 ed 文档标识) sel)))
(define (编辑-删除)
  (lambda (ed 文档标识 sel) ((缓冲-操作-删除) (编辑器-文档-缓冲 ed 文档标识) sel)))
;; 通用逃生门：显式区间的替换（程序化编辑）
(define (编辑-拼接 起点 末尾 文本)
  (lambda (_ed _bid _sel) (编辑-描述 起点 末尾 文本)))

;;; ---------- 薄封装：按 文档标识 + 位置 / 批量 描述集（程序面） ----------

;; 按 文档标识 取它任一 视口 的 视口标识。文档 没有任何 视口 时无法承载显示语义（反应），
;; 也没有可取的选区上下文 → 明确报错。
(define (文档-视口标识 报错者 ed 文档标识)
  (define v (文档的视口 ed 文档标识))
  (unless v (error 报错者 "document ~a 没有任何 view，无法编辑" 文档标识))
  (视口-标识 v))

(define (编辑器-文档-编辑-在 ed 文档标识 p 操作
                        #:反应 [反应 'none]
                        #:受信? [受信? #f]
                        #:记录? [记录? '默认])
  (编辑器-命令 ed 操作
                  #:视口 (文档-视口标识 '编辑器-文档-编辑-在 ed 文档标识)
                  #:选区 (list (插入符 p))
                  #:受信? 受信?
                  #:反应 反应
                  #:记录? 记录?
                  #:编辑前位置 p))

(define (编辑器-文档-编辑-在-批 ed 文档标识 描述集
                              #:反应 [反应 'none]
                              #:受信? [受信? #f]
                              #:记录? [记录? '默认])
  (编辑器-命令-批 ed (编辑列表->变更 描述集)
                        #:视口 (文档-视口标识 '编辑器-文档-编辑-在-批 ed 文档标识)
                        #:受信? 受信?
                        #:反应 反应
                        #:记录? 记录?
                        #:编辑前位置 (编辑列表-最小-起点 描述集)))

;; 批量没有唯一编辑点；前-位置 取最左（文档序）施加点，撤销后光标落到最靠前的改动处。
(define (编辑列表-最小-起点 ds)
  (for/fold ([p #f]) ([d (in-list ds)])
    (define s (编辑-描述-起点 d))
    (if (or (not p) (位置<? s p)) s p)))


;;; ---------- 显式视图命令（程序面：只动一个 视口，不镜像、不抢焦点） ----------
;; 全部按 视口标识 定位，绝不读也不改 焦点；同 文档 其它 视口 一律不动。

(define (视图的窗口 ed 视口标识) (视口-窗口 (编辑器-视口-引用 ed 视口标识)))

;; 裸写视图态（光标/视口/模式，只夹紧、不同步）；读口是 编辑器-视口-窗口。
;; **不改文档**：w 的 文档 必须就是该 视口 当前的 文档；换文档用 编辑器-视口-设置-文档。
(define (编辑器-视口-安装-窗口 ed 视口标识 w)
  (define v (编辑器-视口-引用 ed 视口标识))
  (unless (eq? (窗口-文档 w) (视口-文档 v))
    (error '编辑器-视口-安装-窗口
           "window 的 document 与该 view 不符；换文档请用 editor-view-set-document"))
  (编辑器-安装-视口 ed 视口标识 w))
(define (编辑器-安装-窗口 ed w)
  (编辑器-视口-安装-窗口 ed (视口-标识 (编辑器-已聚焦-视口 ed)) w))

(define (编辑器-视口-设置-位置 ed 视口标识 p)
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-位置 (视图的窗口 ed 视口标识) p)))

(define (编辑器-视口-设置-选区列表 ed 视口标识 sels [主选区-索引 0])
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-选区列表 (视图的窗口 ed 视口标识) sels 主选区-索引)))

;; 选区集：安装一个命名选区集 / 清除（收敛为单个 主导 选区）。**何时清除由上层决定**。
(define (编辑器-视口-安装-选区集 ed 视口标识 g)
  (编辑器-安装-视口 ed 视口标识 (窗口-安装-选区集 (视图的窗口 ed 视口标识) g)))
(define (编辑器-安装-选区集 ed g)
  (编辑器-视口-安装-选区集 ed (视口-标识 (编辑器-已聚焦-视口 ed)) g))
(define (编辑器-视口-清空-选区集 ed 视口标识)
  (编辑器-安装-视口 ed 视口标识 (窗口-清空-选区集 (视图的窗口 ed 视口标识))))
(define (编辑器-清空-选区集 ed)
  (编辑器-视口-清空-选区集 ed (视口-标识 (编辑器-已聚焦-视口 ed))))
(define (编辑器-视口-添加-选区列表 ed 视口标识 sels #:主选区? [主选区? #f])
  (编辑器-安装-视口 ed 视口标识 (窗口-添加-选区列表 (视图的窗口 ed 视口标识) sels #:主选区? 主选区?)))
(define (编辑器-视口-移除-选区列表 ed 视口标识 sels)
  (编辑器-安装-视口 ed 视口标识 (窗口-移除-选区列表 (视图的窗口 ed 视口标识) sels)))

;; 回单光标：把该 视口 的选区坍缩成 主选区 处的一个空选区
(define (编辑器-视口-收敛-选区列表 ed 视口标识)
  (define w (视图的窗口 ed 视口标识))
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-位置 w (窗口-位置 w))))

(define (编辑器-视口-设置-尺寸 ed 视口标识 高度 宽度)
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-尺寸 (视图的窗口 ed 视口标识) 高度 宽度)))

(define (编辑器-视口-设置-模式 ed 视口标识 模式)
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-模式 (视图的窗口 ed 视口标识) 模式)))

;; 行号栏开关（视图装饰；只动指定 视口）。
(define (编辑器-视口-设置-行号 ed 视口标识 开?)
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-行号 (视图的窗口 ed 视口标识) 开?)))

(define (编辑器-视口-设置-顶行 ed 视口标识 n)
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-顶行 (视图的窗口 ed 视口标识) n)))

(define (编辑器-视口-设置-顶段 ed 视口标识 n)
  (编辑器-安装-视口 ed 视口标识 (窗口-设置-顶段 (视图的窗口 ed 视口标识) n)))

