;;; ---------- 缓冲 元数据 ----------

(define (编辑器-文档-设置-名称 ed 文档标识 名称)
  (编辑器-安装-文档-名称 ed 文档标识 名称))

;;; ---------- 属性写（改 文档 的属性；不碰文本，光标自然不动） ----------
;; 走 变更 命令：与文本编辑同一条路径；#:记录? 默认 '默认（跟随 文档 策略），
;; 可用 #:记录? #t / #f 覆盖。

(define (编辑器-文档-施加-编辑列表 ed 文档标识 描述集 #:记录? [记录? '默认])
  (编辑器-命令-批 ed (编辑列表->变更 描述集)
                        #:视口 (文档-视口标识 '编辑器-文档-施加-编辑列表 ed 文档标识)
                        #:记录? 记录?))

(define (编辑器-文档-施加-属性集 ed 文档标识 属性集 #:记录? [记录? '默认])
  (编辑器-命令-批 ed (属性集->变更 属性集)
                        #:视口 (文档-视口标识 '编辑器-文档-施加-属性集 ed 文档标识)
                        #:记录? 记录?))

;; 单段 set / remove：坐标 = 行 + 半开列区间（属性天生同行）。
(define (编辑器-文档-安装-属性 ed 文档标识 键 行 c0 c1 值 #:记录? [记录? '默认])
  (编辑器-文档-施加-属性集 ed 文档标识
    (list (属性-设置 (位置 行 c0) (位置 行 c1) 键 值)) #:记录? 记录?))
(define (编辑器-文档-移除-属性 ed 文档标识 键 行 c0 c1 #:记录? [记录? '默认])
  (编辑器-文档-施加-属性集 ed 文档标识
    (list (属性-移除 (位置 行 c0) (位置 行 c1) 键)) #:记录? 记录?))

;; 替换式：把 键 在 [l0,l1] 行的值整体换成 跨度集（旧的先清）。
;; 跨度集 : (listof (list 行 c0 c1 值))；单行是特例 `#:行列表 L L`。
(define (编辑器-文档-替换-属性 ed 文档标识 键 跨度集
                                     #:行列表 [l0 0] [l1 (sub1 (编辑器-文档-行-数量 ed 文档标识))]
                                     #:记录? [记录? '默认])
  (编辑器-命令-批 ed
    (文档-替换-属性-变更 (编辑器-文档 ed 文档标识) 键 跨度集 #:行列表 l0 l1)
    #:视口 (文档-视口标识 '编辑器-文档-替换-属性 ed 文档标识)
    #:记录? 记录?))

;;; ---------- 历史策略 / 清栈 ----------
;; 策略位在 文档：开文档时 #:历史? 定默认；这里运行时查询/切换。

(define (编辑器-视口-设置-历史-启用 ed 视口标识 开?)
  (编辑器-安装-历史-启用 ed (编辑器-视口-文档-标识 ed 视口标识) 开?))
(define (编辑器-设置-历史-启用 ed 开?)
  (编辑器-视口-设置-历史-启用 ed (视口-标识 (编辑器-已聚焦-视口 ed)) 开?))
;; 清栈（焦点 糖：文档标识 缺省 = 焦点 文档）
(define (编辑器-文档-清空-历史 ed [文档标识 (编辑器-文档-标识 ed)]) (编辑器-安装-历史-清空 ed 文档标识))
(define (编辑器-视口-清空-历史 ed 视口标识)
  (编辑器-安装-历史-清空 ed (编辑器-视口-文档-标识 ed 视口标识)))

;;; ---------- 测试 ----------

(module+ test
  ;; 默认 none：内容变了，光标字面不动
  (define e0 (编辑器-打开 "hello"))
  (define-values (e1 r1) (编辑器-文档-编辑-在 e0 0 (位置 0 0) (编辑-拼接 (位置 0 0) (位置 0 0) "XY")))
  (check-equal? (编辑器-文档->字符串 e1 0) "XYhello")
  (check-equal? (编辑器-位置 e1) (位置 0 0))          ; none
  (check-equal? (变更-报告-首-行 r1) 0)
  (check-equal? (变更-报告-文本集 r1)
                (list (编辑-描述 (位置 0 0) (位置 0 0) "XY")))   ; 施加顺序的生效 描述
  (check-equal? (变更-报告-属性集 r1) '())
  (check-true (编辑器-文档-可撤销? e1 0))                  ; 默认跟随 文档 策略（#:历史? #t）
  ;; #:记录? #f：显式不记账
  (define-values (e1n _r1n) (编辑器-文档-编辑-在 e0 0 (位置 0 0) (编辑-拼接 (位置 0 0) (位置 0 0) "XY") #:记录? #f))
  (check-false (编辑器-文档-可撤销? e1n 0))

  ;; 'map：光标跟随文本（光标在编辑点之后才会右移）
  (define e0s (编辑器-设置-位置 e0 (位置 0 3)))
  (define-values (e2 _r2) (编辑器-文档-编辑-在 e0s 0 (位置 0 1) (编辑-插入 "XY") #:反应 'map))
  (check-equal? (编辑器-文档->字符串 e2 0) "hXYello")
  (check-equal? (编辑器-位置 e2) (位置 0 5))          ; (0,3) 映射到 (0,5)
  ;; 同一场景用 none（不传 #:反应）：光标字面不动
  (define-values (e2n _r2n) (编辑器-文档-编辑-在 e0s 0 (位置 0 1) (编辑-插入 "XY")))
  (check-equal? (编辑器-位置 e2n) (位置 0 3))

  ;; #:记录? #t：记一步，前-位置 = 编辑点
  (define-values (e3 _r3) (编辑器-文档-编辑-在 e0 0 (位置 0 2) (编辑-插入 "Z") #:记录? #t))
  (check-true (编辑器-文档-可撤销? e3 0))

  ;; #:受信? #t 跳过 只读 守卫
  (define-values (tr _trr) (编辑器-文档-安装-属性 (编辑器-打开 "abc") 0 只读键 0 0 3 #t))
  (define-values (tr1 rtr1) (编辑器-文档-编辑-在 tr 0 (位置 0 1) (编辑-插入-字符 #\X)))
  (check-false rtr1)                                    ; 守卫版被拒
  (check-equal? (编辑器-文档->字符串 tr1 0) "abc")
  (define-values (tr2 _rtr2) (编辑器-文档-编辑-在 tr 0 (位置 0 1) (编辑-插入-字符 #\X) #:受信? #t))
  (check-equal? (编辑器-文档->字符串 tr2 0) "aXbc")

  ;; 属性写：只改属性、不碰文本/光标；默认跟随 文档 策略（可撤销）
  (define-values (an _anr) (编辑器-文档-安装-属性 (编辑器-打开 "hello") 0 只读键 0 0 5 #t))
  (check-true (属性-只读? (编辑器-文档-属性集-在 an 0 (位置 0 2))))
  (check-true (编辑器-文档-可撤销? an 0))

  ;; 替换式属性写：单行（#:行列表 L L）与多行整体替换（范围外不动、范围内缺省清空）
  (define-values (ap0 _ap0r) (编辑器-文档-替换-属性 (编辑器-打开 "aa\nbb\ncc") 0 只读键 (list (list 0 1 2 'x)) #:行列表 0 0))
  (check-equal? (编辑器-文档-属性集-键-片段集 ap0 0 0 只读键) (list (list 1 2 'x)))
  (define-values (ap _apr) (编辑器-文档-替换-属性 ap0 0 只读键 (list (list 0 0 2 'y) (list 2 0 2 'z)) #:行列表 0 2))
  (check-equal? (编辑器-文档-属性集-键-片段集 ap 0 0 只读键) (list (list 0 2 'y)))
  (check-equal? (编辑器-文档-属性集-键-片段集 ap 0 1 只读键) '())        ; 范围内没给 → 清空
  (check-equal? (编辑器-文档-属性集-键-片段集 ap 0 2 只读键) (list (list 0 2 'z)))
  (define-values (ap2 _ap2r) (编辑器-文档-替换-属性 ap 0 只读键 (list (list 1 1 2 'w)) #:行列表 1 1))
  (check-equal? (编辑器-文档-属性集-键-片段集 ap2 0 0 只读键) (list (list 0 2 'y)))  ; 范围外不动
  (check-equal? (编辑器-文档-属性集-键-片段集 ap2 0 1 只读键) (list (list 1 2 'w)))
  ;; 读口输出加个行号即可写回（同形状）
  (define-values (ap3 _ap3r) (编辑器-文档-替换-属性 ap 0 只读键
                                                           (for/list ([r (in-list (编辑器-文档-属性集-键-片段集 ap 0 0 只读键))])
                                                             (cons 0 r))
                                                           #:行列表 0 0))
  (check-equal? (编辑器-文档-属性集-键-片段集 ap3 0 0 只读键) (list (list 0 2 'y)))

  ;; 文档 级历史策略：#:历史? #f 的文档不记账（用户面/程序面/属性写都不记）
  (define noh (编辑器-打开 "abc" 5 20 #:历史? #f))
  (check-false (编辑器-文档-历史启用? noh))
  (define-values (noh1 _nohr1) (编辑器-命令 noh (编辑-插入 "X")))
  (check-equal? (编辑器-文档->字符串 noh1 0) "Xabc")
  (check-false (编辑器-文档-可撤销? noh1))
  (define-values (noh2 _nohr2) (编辑器-文档-安装-属性 noh1 0 只读键 0 0 1 #t))
  (check-false (编辑器-文档-可撤销? noh2))
  ;; 显式 #:记录? #t 仍可强制记
  (define-values (noh3 _nohr3) (编辑器-命令 noh1 (编辑-插入 "X") #:记录? #t))
  (check-true (编辑器-文档-可撤销? noh3))
  ;; 切换策略 / 清栈
  (define yesh (编辑器-设置-历史-启用 noh #t))
  (check-true (编辑器-文档-历史启用? yesh))
  (define-values (yesh1 _yeshr1) (编辑器-命令 yesh (编辑-插入 "X")))
  (check-true (编辑器-文档-可撤销? yesh1))
  (check-false (编辑器-文档-可撤销? (编辑器-文档-清空-历史 yesh1)))

  ;; 文本 + 属性一条命令：插入 "X" 并标只读 —— 一次记一步、报告 含文本与属性
  (define cx0 (编辑器-打开 "abc"))
  (define-values (cx1 rx)
    (编辑器-命令 cx0 (编辑-插入 "X")
                    #:选区 (list (插入符 (位置 0 1)))
                    #:属性集 (lambda (_ed _bid 文本集)
                              (for/list ([d (in-list 文本集)])
                                (属性-设置 (编辑-描述-起点 d) (编辑描述-之后的-位置 d)
                                          只读键 #t)))
                    #:反应 '主导 #:记录? #t))
  (check-equal? (编辑器-文档->字符串 cx1 0) "aXbc")
  (check-equal? (编辑器-文档-属性集-键-片段集 cx1 0 0 只读键) (list (list 1 2 #t)))
  (check-equal? (变更-报告-文本集 rx) (list (编辑-描述 (位置 0 1) (位置 0 1) "X")))
  (check-equal? (变更-报告-属性集 rx) (list (属性-设置 (位置 0 1) (位置 0 2) 只读键 #t)))
  (check-equal? (编辑器-文档-撤销-深度 cx1 0) 1)             ; 文本与属性合成一步

  ;; 显式视图命令：按 视口标识 定位，只动目标 视口，不动焦点
  (define v0 (编辑器-打开 "l0\nl1\nl2\nl3\nl4" 2 10))
  (define-values (v1 vv) (编辑器-添加-视口 v0 0 2 10 #:焦点? #f))
  (define v2 (编辑器-视口-设置-顶行 v1 vv 2))
  (check-equal? (编辑器-视口-顶行 v2 vv) 2)          ; 目标 视口 动了
  (check-equal? (编辑器-视口-顶行 v2 0) 0)           ; 另一个 视口 不动
  (define v3 (编辑器-视口-设置-左列 v2 vv 3))
  (check-equal? (编辑器-视口-左列 v3 vv) 3)
  (define v4 (编辑器-视口-设置-模式 v3 vv '折行))
  (check-equal? (编辑器-视口-模式 v4 vv) '折行)
  (check-equal? (编辑器-视口-模式 v4 0) '裁剪)
  (define v5 (编辑器-视口-设置-同步 v4 vv '跟随))
  (check-equal? (编辑器-视口-同步 v5 vv) '跟随)

  ;; 折行 下的折行段：顶段 可写且被夹紧到合法域
  (define ts0 (编辑器-打开 "abcdefghij" 2 3))
  (define ts1 (编辑器-视口-设置-模式 ts0 0 '折行))
  (define ts2 (编辑器-视口-设置-顶段 ts1 0 1))
  (check-equal? (编辑器-视口-顶段 ts2 0) 1)
  (define-values (v5b other) (编辑器-打开-文档 v5 "OTHER" 2 10 #:名称 "other" #:焦点? #f))
  (define v6 (编辑器-视口-设置-文档 v5b vv other))
  (check-equal? (编辑器-视口-文档-标识 v6 vv) other)
  (check-equal? (编辑器-文档-标识 v6) 0)         ; 焦点不动

  ;; 焦点 糖仍作用于焦点 视口
  (define v7 (编辑器-视口-设置-位置 v6 0 (位置 1 0)))
  (check-equal? (编辑器-视口-位置 v7 0) (位置 1 0))
  ;; 焦点 视口 写糖（与 编辑器-视口-设置-* 镜像）
  (define v8 (编辑器-设置-顶行 (编辑器-设置-左列 (编辑器-设置-模式 v7 '折行) 2) 1))
  (check-equal? (编辑器-顶行 v8) 1)
  (check-equal? (编辑器-左列 v8) 2)
  (check-equal? (编辑器-模式 v8) '折行)

  ;; 批量：一次施多条，记一步，报告.编辑列表 为施加顺序（起点倒序）
  (define b0 (编辑器-打开 "abcd\nefgh"))
  (define-values (b1 rb)
    (编辑器-文档-编辑-在-批 b0 0 (list (编辑-描述 (位置 0 1) (位置 0 1) "X")
                                     (编辑-描述 (位置 1 2) (位置 1 2) "Y"))
                          #:记录? #t))
  (check-equal? (编辑器-文档->字符串 b1 0) "aXbcd\nefYgh")
  (check-equal? (变更-报告-文本集 rb)
                (list (编辑-描述 (位置 1 2) (位置 1 2) "Y")
                      (编辑-描述 (位置 0 1) (位置 0 1) "X")))
  (check-equal? (编辑器-文档-撤销-深度 b1 0) 1)                    ; 整批一步
  (check-equal? (编辑器-位置 b1) (位置 0 0))                 ; 默认 none：光标不动

  ;; 批量被守卫拒 → 整体没发生；#:受信? #t 强施
  (define-values (bt _btr) (编辑器-文档-安装-属性 (编辑器-打开 "abc") 0 只读键 0 0 3 #t))
  (define-values (bt1 rbt1) (编辑器-文档-编辑-在-批 bt 0 (list (编辑-描述 (位置 0 1) (位置 0 1) "X"))))
  (check-false rbt1)
  (check-equal? (编辑器-文档->字符串 bt1 0) "abc")
  (define-values (bt2 _rbt2) (编辑器-文档-编辑-在-批 bt 0 (list (编辑-描述 (位置 0 1) (位置 0 1) "X")) #:受信? #t))
  (check-equal? (编辑器-文档->字符串 bt2 0) "aXbc")

  ;; 加/减选区（并集/差集；主选区 保持；不允许空集）
  (define se0 (编辑器-打开 "abcdef"))
  (define se1 (编辑器-添加-选区列表 se0 (list (插入符 (位置 0 1)))))
  (check-equal? (length (编辑器-选区列表 se1)) 2)
  (define se2 (编辑器-添加-选区列表 se1 (list (选区 (位置 0 3) (位置 0 5)))))
  (check-equal? (length (编辑器-选区列表 se2)) 3)
  (define se3 (编辑器-移除-选区列表 se2 (list (插入符 (位置 0 1)))))
  (check-equal? (length (编辑器-选区列表 se3)) 2)
  (check-equal? (length (编辑器-选区列表 (编辑器-移除-选区列表 se0 (list (插入符 (位置 0 0)))))) 1)
  ;; 去重：加一个已存在的选区不变多
  (check-equal? (length (编辑器-选区列表 (编辑器-添加-选区列表 se0 (list (插入符 (位置 0 0)))))) 1)

  ;; 主选区 控制 + 收敛
  (define pr0 (编辑器-打开 "abcdef"))
  (define pr1 (编辑器-设置-选区列表 pr0 (list (插入符 (位置 0 0)) (插入符 (位置 0 3))) 1))
  (check-equal? (编辑器-位置 pr1) (位置 0 3))              ; 主选区 = 传入的第 1 个
  (define pr2 (编辑器-添加-选区列表 pr1 (list (插入符 (位置 0 5))) #:主选区? #t))
  (check-equal? (编辑器-位置 pr2) (位置 0 5))              ; 新加的成为 主选区
  (define pr3 (编辑器-收敛-选区列表 pr2))
  (check-equal? (length (编辑器-选区列表 pr3)) 1)
  (check-equal? (编辑器-位置 pr3) (位置 0 5))

  ;; 焦点 糖：同步 / 缓冲 / 重命名
  (define fs0 (编辑器-打开 "x"))
  (check-equal? (编辑器-同步 (编辑器-设置-同步 fs0 '跟随)) '跟随)
  (define-values (fs1 bid2) (编辑器-打开-文档 fs0 "y" #:名称 "b" #:焦点? #f))
  (define fs2 (编辑器-设置-文档 fs1 bid2))
  (check-equal? (编辑器-文档-标识 fs2) bid2)
  (check-equal? (编辑器-文档-名称 (编辑器-文档-设置-名称 fs2 bid2 "renamed") bid2) "renamed")

  ;; 选区集合算子：显式 主选区 + map 全部 / map 主选区 + 增删
  (define sm0 (编辑器-打开 "abcde"))
  (define sm1 (编辑器-设置-选区列表 sm0 (list (插入符 (位置 0 0)) (插入符 (位置 0 2))) 1))
  (check-equal? (编辑器-主选区 sm1) (插入符 (位置 0 2)))
  (check-true (编辑器-选区-成员? sm1 (插入符 (位置 0 0))))
  (define sm2 (编辑器-映射-主选区 sm1
                (lambda (s) (选区-映射-头部 (lambda (p) (位置-右 (编辑器-文档-缓冲 sm1 0) p)) s))))
  (check-equal? (编辑器-主选区 sm2) (选区 (位置 0 2) (位置 0 3)))
  (define sm3 (编辑器-映射-选区列表 sm1
                (lambda (s) (选区-映射-两端 (lambda (p) (位置-左 (编辑器-文档-缓冲 sm1 0) p)) s))))
  (check-equal? (map 选区-头部 (编辑器-选区列表 sm3)) (list (位置 0 0) (位置 0 1)))
  (check-equal? (编辑器-主选区 (编辑器-添加-选区 sm1 (插入符 (位置 0 4)) #:主选区? #t)) (插入符 (位置 0 4)))
  (check-equal? (length (编辑器-选区列表 (编辑器-移除-选区 sm1 (插入符 (位置 0 0))))) 1)
  (check-equal? (编辑器-主选区 (编辑器-设置-主选区 sm1 (插入符 (位置 0 0)))) (插入符 (位置 0 0)))

  ;; 裸写整个 窗口 + 组合：读 窗口 → 窗口-* 算子 → 安装-窗口
  (define pw0 (编辑器-打开 "abcdef"))
  (define pw1 (编辑器-安装-窗口 pw0 (窗口-设置-位置 (编辑器-窗口 pw0) (位置 0 3))))
  (check-equal? (编辑器-位置 pw1) (位置 0 3))
  ;; 安装-窗口 只写视图态：文档 不符 → 报错（换文档用 编辑器-视口-设置-文档）
  (check-exn exn:fail? (lambda () (编辑器-安装-窗口 pw0 (窗口-打开 (文档-打开 "x") 2 10))))
  ;; 映射-位置列表：对每个选区 头部 施 位置→位置（坍缩成光标）
  (define pw2 (编辑器-映射-位置列表 pw1 (lambda (p) (位置 0 (add1 (位置-列 p))))))
  (check-equal? (编辑器-位置 pw2) (位置 0 4))
  ;; 主选区 下标：读 / 写
  (define pv (编辑器-设置-选区列表 pw0 (list (插入符 (位置 0 0)) (插入符 (位置 0 3)))))
  (check-equal? (编辑器-主选区-索引 pv) 0)
  (check-equal? (编辑器-主选区-索引 (编辑器-设置-主选区-索引 pv 1)) 1)

  ;; 命名选区集：安装 -> 插入（作用于集合内所有区间）-> 上层自己清除
  (define gg0 (编辑器-打开 "foo bar foo" 5 20))
  (define gg1 (编辑器-安装-选区集 gg0
                (选区集-打开 'foo (list (选区 (位置 0 0) (位置 0 3))
                                       (选区 (位置 0 8) (位置 0 11))) 0)))
  (check-equal? (编辑器-选区集-名称 gg1) 'foo)
  (check-equal? (length (编辑器-选区列表 gg1)) 2)
  (define-values (gg2 _ggr) (编辑器-命令 gg1 (编辑-插入 "X") #:反应 '主导))
  (check-equal? (编辑器-文档->字符串 gg2 0) "X bar X")
  (check-equal? (编辑器-选区集-名称 gg2) 'foo)        ; 编辑后名字保持
  (define gg3 (编辑器-清空-选区集 gg2))
  (check-false (编辑器-选区集-名称 gg3))
  (check-equal? (length (编辑器-选区列表 gg3)) 1)  ; 收敛为单个 主导

  ;; 行号栏开关（视图装饰；只动指定 视口）
  (define ln0 (编辑器-打开 "a\nb\nc" 3 10))
  (check-false (编辑器-行号? ln0))
  (define ln1 (编辑器-设置-行号 ln0 #t))
  (check-true (编辑器-行号? ln1))
  (check-true (编辑器-视口-行号? ln1 0))
  (check-false (编辑器-行号? (编辑器-设置-行号 ln1 #f)))
  (define-values (ln2 lnv) (编辑器-添加-视口 ln0 0 3 10 #:行号? #t))
  (check-true (编辑器-视口-行号? ln2 lnv))

  ;; 文本批量（与 编辑器-文档-施加-属性集 对称）：一次多条、报告含生效 描述集
  (define be0 (编辑器-打开 "abcd\nefgh"))
  (define-values (be1 ber)
    (编辑器-文档-施加-编辑列表 be0 0 (list (编辑-描述 (位置 0 1) (位置 0 1) "X")
                                    (编辑-描述 (位置 1 2) (位置 1 2) "Y"))))
  (check-equal? (编辑器-文档->字符串 be1 0) "aXbcd\nefYgh")
  (check-equal? (变更-报告-文本集 ber) (list (编辑-描述 (位置 1 2) (位置 1 2) "Y")
                                                (编辑-描述 (位置 0 1) (位置 0 1) "X")))
  (check-equal? (编辑器-位置 be1) (位置 0 0))            ; 'none：光标不动

  (displayln "program.rkt: all tests passed"))
