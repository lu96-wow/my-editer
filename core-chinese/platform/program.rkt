;; 对每个选区 头部 施加 f（位置 → 位置），坍缩成光标。
(define (编辑器-视口-映射-位置列表 ed 视口标识 f)
  (编辑器-安装-视口 ed 视口标识 (窗口-映射-位置列表 (视图的窗口 ed 视口标识) f)))
(define (编辑器-视口-添加-选区 ed 视口标识 s #:主选区? [主选区? #f])
  (编辑器-安装-视口 ed 视口标识 (窗口-添加-选区 (视图的窗口 ed 视口标识) s #:主选区? 主选区?)))
(define (编辑器-视口-移除-选区 ed 视口标识 s)
  (编辑器-安装-视口 ed 视口标识 (窗口-移除-选区 (视图的窗口 ed 视口标识) s)))
(define (编辑器-视口-设置-主选区 ed 视口标识 s)
