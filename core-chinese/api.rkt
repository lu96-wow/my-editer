;;; ============================================================================
;;; 冒烟测试：门面 + 一条完整「文档 → 画面」链
;;; ============================================================================

(module+ test
  (require rackunit)

  (define b (缓冲-打开 "hello\nworld"))
  ;; 缓冲 基本读口
  (check-equal? (缓冲->字符串 b) "hello\nworld")
  (check-equal? (缓冲-行-数量 b) 2)

  ;; 原子链：文档 → 编辑 → 窗口 → 屏幕
  (define d (文档-打开 "hello\nworld"))
  (define-values (d1 描述) (文档-编辑-在 d (位置 0 0) (缓冲-操作-插入-字符 #\X)))
  (check-equal? (文档->字符串 d1) "Xhello\nworld")
  (check-equal? 描述 (编辑-描述 (位置 0 0) (位置 0 0) "X"))
  (check-equal? (屏幕-高度 (窗口->屏幕 (窗口-打开 d1 2 10))) 2)
  (check-equal? (屏幕-屏行 (窗口->屏幕 (窗口-打开 d1 2 10)) 0)
                (list (片段 0 "Xhello" #f)))

  ;; 派生 外观 由投影参数 提供者 给出，不进文档
  (define (提供者 _b _line) (list (list 0 5 (hash '外观 '关键字))))
  (check-equal? (屏幕-屏行 (窗口->屏幕 (窗口-打开 d 2 10) 提供者) 0)
                (list (片段 0 "hello" (hash '外观 '关键字))))
  (check-equal? (屏幕-屏行 (窗口->屏幕 (窗口-打开 d1 2 10)) 0)
                (list (片段 0 "Xhello" #f)))

  (displayln "api.rkt: all tests passed"))
