#lang racket

(require "../atom/point.rkt" "../atom/content.rkt" "../atom/edit.rkt"
         "../atom/selection.rkt" rackunit)

;;; doc/buffer.rkt —— 纯文本值：内容 + 版本戳
;;;
;;; **不再含 属性集，也不含任何编辑施加**。缓冲 只回答「文本是什么、行/列几何、
;;; 文本版本号」；一切编辑（文本 + 属性）在 doc/document.rkt 的漏斗里发生。
;;;
;;;   缓冲 = 内容 ⊕ 版本戳        版本戳 = 本 缓冲 的版本戳（由 文档 漏斗 +1）
;;;
;;; 文本动作（缓冲-操作-*）与逆（缓冲-编辑-描述-逆）只依赖 内容，
;;; 输出 编辑-描述 值，不施加——施加是 文档 的事。

(provide
 缓冲?                            ; 构造器/内部字段不外露（避免绕过不变量）
 缓冲-打开
 缓冲-内容                       ; 文本原子（供 文档 漏斗）
 缓冲->字符串
 缓冲->行列表
 缓冲-行-数量
 缓冲-行-引用
 缓冲-行-长度
 缓冲-夹紧-位置
 缓冲-位置->偏移
 缓冲-偏移->位置
 缓冲-范围-文本
 缓冲-夹紧-编辑-描述集
 缓冲-内容-相等?
 缓冲-版本戳
 缓冲-设置-内容                   ; 仅供 文档 漏斗
 缓冲-递增                          ; 仅供 文档 漏斗
 ;; 文本动作（可传的值；操作 : 缓冲 选区 → 描述/#f）
 缓冲-操作-插入-字符
 缓冲-操作-插入
 缓冲-操作-换行
 缓冲-操作-退格
 缓冲-操作-删除
 缓冲-操作-拼接
 缓冲-编辑-描述-逆)

;;; ---------- 数据 ----------

(struct 缓冲
  (内容 ; content.rkt
   版本戳)   ; nat      本 缓冲 的版本戳（文档 漏斗每次**文本**变更 +1）
  #:transparent)

;;; ---------- 构造 / 投影 ----------

(define (缓冲-打开 s)
  (缓冲 (字符串转内容 s) 0))

(define (缓冲->字符串 b) (内容->字符串 (缓冲-内容 b)))
(define (缓冲->行列表 b)  (内容->行列表  (缓冲-内容 b)))
(define (缓冲-行-数量 b) (内容-行-数量 (缓冲-内容 b)))
(define (缓冲-行-引用 b i) (内容-行-引用 (缓冲-内容 b) i))
(define (缓冲-行-长度 b i) (内容-行-长度 (缓冲-内容 b) i))

;; 位置解析只取决于文本，与窗口/光标/属性无关。
(define (缓冲-夹紧-位置 b p) (内容-夹紧-位置 (缓冲-内容 b) p))
(define (缓冲-位置->偏移 b p) (内容-位置->偏移 (缓冲-内容 b) p))
(define (缓冲-偏移->位置 b 偏移) (内容-偏移->位置 (缓冲-内容 b) 偏移))

;; 文本是否同一：只有真正换 内容 才不等（属性不再参与）。
(define (缓冲-内容-相等? a b) (eq? (缓冲-内容 a) (缓冲-内容 b)))

;; 换 内容（保留 版本戳）/ 版本 +1。**仅供 文档 漏斗**，不对外当编辑入口。
(define (缓冲-设置-内容 b c) (缓冲 c (缓冲-版本戳 b)))
(define (缓冲-递增 b) (struct-copy 缓冲 b [版本戳 (add1 (缓冲-版本戳 b))]))

;; 取区间文本（[起点,末尾) 半开）。
(define (缓冲-范围-文本 b s e)
  (define sl (位置-行 s)) (define sc (位置-列 s))
  (define el (位置-行 e)) (define ec (位置-列 e))
  (cond
    [(= sl el) (substring (缓冲-行-引用 b sl) sc ec)]
    [else
     (string-join
      (append (list (substring (缓冲-行-引用 b sl) sc
                               (string-length (缓冲-行-引用 b sl))))
              (for/list ([l (in-range (add1 sl) el)]) (缓冲-行-引用 b l))
              (list (substring (缓冲-行-引用 b el) 0 ec)))
      "\n")]))

;; 把一串文本 描述 夹到生效域（不动 缓冲）。
(define (缓冲-夹紧-编辑-描述集 b 描述集)
  (map (lambda (d) (内容-夹紧-描述 (缓冲-内容 b) d)) 描述集))

;;; ---------- 文本动作（只算 描述，不施加） ----------
;;; 形状统一：操作 : 缓冲 选区 → (or/c #f 编辑-描述)。

(define (缓冲-操作-插入 文本)
  (lambda (_b sel)
    (define-values (a z) (选区-范围 sel))
    (编辑-描述 a z 文本)))
(define (缓冲-操作-插入-字符 字符) (缓冲-操作-插入 (string 字符)))
(define (缓冲-操作-换行)       (缓冲-操作-插入 "\n"))
(define (缓冲-操作-退格)
  (lambda (b sel)
    (if (插入符? sel)
        (内容-退格-描述 (缓冲-内容 b) (选区-头部 sel))
        (let-values ([(a z) (选区-范围 sel)]) (编辑-描述 a z "")))))
(define (缓冲-操作-删除)
  (lambda (b sel)
    (if (插入符? sel)
        (内容-删除-描述 (缓冲-内容 b) (选区-头部 sel))
        (let-values ([(a z) (选区-范围 sel)]) (编辑-描述 a z "")))))
;; 通用逃生门：显式区间的替换（程序化编辑）
(define (缓冲-操作-拼接 起点 末尾 文本) (lambda (_b _sel) (编辑-描述 起点 末尾 文本)))

;; 用「编辑前的 缓冲」取回 d 删掉的文本，求逆。
(define (缓冲-编辑-描述-逆 b d)
  (编辑-描述-逆 d (缓冲-范围-文本 b (编辑-描述-起点 d) (编辑-描述-末尾 d))))

;;; ---------- 测试 ----------

(module+ test
  (define b0 (缓冲-打开 "hello\nworld"))
  (check-equal? (缓冲->字符串 b0) "hello\nworld")
  (check-equal? (缓冲->行列表 b0) '("hello" "world"))
  (check-equal? (缓冲-行-数量 b0) 2)
  (check-equal? (缓冲-版本戳 b0) 0)
  (check-true (缓冲-内容-相等? b0 b0))
  (check-equal? (缓冲-行-长度 b0 0) 5)
  (check-equal? (缓冲-行-长度 b0 99) 5)
  (check-equal? (缓冲-夹紧-位置 b0 (位置 9 9)) (位置 1 5))
  (check-equal? (缓冲-位置->偏移 b0 (位置 1 0)) 6)
  (check-equal? (缓冲-偏移->位置 b0 11) (位置 1 5))
  (check-equal? (缓冲-范围-文本 b0 (位置 0 1) (位置 1 2)) "ello\nwo")

  ;; 文本动作只算 描述
  (check-equal? ((缓冲-操作-插入-字符 #\X) b0 (插入符 (位置 0 0)))
                (编辑-描述 (位置 0 0) (位置 0 0) "X"))
  ;; 反向选区（头部 在 锚点 左）→ 归一为正向区间，不得产生反向 描述
  (check-equal? ((缓冲-操作-插入 "X") b0 (选区 (位置 0 3) (位置 0 1)))
                (编辑-描述 (位置 0 1) (位置 0 3) "X"))
  (check-equal? ((缓冲-操作-退格) b0 (插入符 (位置 1 0)))
                (编辑-描述 (位置 0 5) (位置 1 0) ""))
  (check-equal? (缓冲-夹紧-编辑-描述集 b0 (list (编辑-描述 (位置 0 1) (位置 0 99) "")))
                (list (编辑-描述 (位置 0 1) (位置 0 5) "")))

  ;; 逆由编辑前 缓冲 求出
  (define d (编辑-描述 (位置 0 1) (位置 0 3) "Z"))
  (check-equal? (缓冲-编辑-描述-逆 b0 d) (编辑-描述 (位置 0 1) (位置 0 2) "el"))

  (displayln "buffer.rkt: all tests passed"))
