#lang racket

(require "point.rkt" rackunit)

;;; atom/attr.rkt —— 属性变更原子（属性-描述）
;;;
;;; 一条 属性-描述 = 「对某一行内区间 [起点,末尾) 上的某个 键 做 设置/移除」。
;;; 与 编辑-描述 并列：编辑-描述 改文本，属性-描述 改属性；两者都只描述**变更**，
;;; 不含旧值/旧状态，因此可以打包进 变更、进账本、可重放。
;;;
;;; 约束（由施加方校验，见 doc/document.rkt）：
;;;   · 起点/末尾 必须**同一行**（属性是行内区间）；
;;;   · 半开 [起点,末尾)；零宽 = no-操作；
;;;   · 坐标是「施加前」的属性坐标。
;;;
;;; 本原子不认识 属性集 集合（那是 unit/attrs.rkt），只定义变更的形状与访问。

(provide
 (struct-out 属性-描述)
 属性-设置
 属性-移除
 属性-描述-空?)

;;; ---------- 数据 ----------

(struct 属性-描述 (起点 末尾 键 操作 值) #:transparent)
;; 起点/末尾 : 位置     同一行，半开 [起点,末尾)
;; 键       : symbol
;; 操作        : 'set | 'remove
;; 值       : any/c     仅 操作 = 'set 时有效

(define (属性-设置 起点 末尾 键 值)    (属性-描述 起点 末尾 键 'set 值))
(define (属性-移除 起点 末尾 键)     (属性-描述 起点 末尾 键 'remove #f))

;; 零宽属性区间没有合法解释为「标注某段」，唯一语义是 no-操作。
(define (属性-描述-空? d) (位置=? (属性-描述-起点 d) (属性-描述-末尾 d)))

;;; ---------- 测试 ----------

(module+ test
  (define p (lambda (l c) (位置 l c)))
  (check-equal? (属性-设置 (p 0 1) (p 0 3) '外观 '粗体)
                (属性-描述 (p 0 1) (p 0 3) '外观 'set '粗体))
  (check-equal? (属性-描述-操作 (属性-移除 (p 0 1) (p 0 3) '外观)) 'remove)
  (check-true (属性-描述-空? (属性-设置 (p 0 2) (p 0 2) '外观 '粗体)))
  (check-false (属性-描述-空? (属性-设置 (p 0 1) (p 0 2) '外观 '粗体)))
  (displayln "attr.rkt: all tests passed"))
