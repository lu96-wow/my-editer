#lang racket

;;; point.rkt —— 文档位置 (行, 列)，全部 0-based。
;;;
;;; 这是 core 里**唯一**的位置表示。规范：
;;;   · 任何「要位置」的函数收 位置（不收散着的 行 列 两参数）。
;;;   · 任何「给位置」的函数返回 位置。
;;; 这样位置的传递永远是一个值，不会出现「两个数字谁先谁后」的约定。
;;;
;;; 位置 **不知道**它所在行有多长、有没有文本；合法性由调用方用 位置-夹紧 保证。

(provide
 (struct-out 位置)
 位置<?
 位置=?
 位置<=?
 坐标<?
 坐标=?
 坐标<=?
 位置-夹紧)

(struct 位置 (行 列) #:transparent)

;;; ---------- 比较 ----------
;; 少构造 位置 的裸比较，给「还没夹紧的输入」这类场景用。
;; 位置比较只有这一份实现，位置<？/位置<=? 是它的 位置 包装。

(define (坐标<? l1 c1 l2 c2)
  (or (< l1 l2) (and (= l1 l2) (< c1 c2))))

(define (坐标=? l1 c1 l2 c2)
  (and (= l1 l2) (= c1 c2)))

(define (坐标<=? l1 c1 l2 c2)
  (or (坐标<? l1 c1 l2 c2) (坐标=? l1 c1 l2 c2)))

(define (位置<? a b)
  (坐标<? (位置-行 a) (位置-列 a) (位置-行 b) (位置-列 b)))

(define (位置=? a b)
  (坐标=? (位置-行 a) (位置-列 a) (位置-行 b) (位置-列 b)))

(define (位置<=? a b)
  (坐标<=? (位置-行 a) (位置-列 a) (位置-行 b) (位置-列 b)))

;;; ---------- 夹紧 ----------
;; 把 位置 夹到合法域：行 ∈ [0, 行-数量)，列 ∈ [0, 第 行 行长]。
;;   行-数量  : nat ≥ 1          总行数
;;   行-长度 : nat -> nat       第 i 行的长度（字符数）
(define (位置-夹紧 p 行-数量 行-长度)
  (unless (and (exact-nonnegative-integer? 行-数量) (>= 行-数量 1))
    (error '位置-夹紧 "line-count must be >= 1, got ~a" 行-数量))
  (define l (max 0 (min (位置-行 p) (sub1 行-数量))))
  (位置 l (max 0 (min (位置-列 p) (行-长度 l)))))

;;; ---------- 测试 ----------

(module+ test
  (require rackunit)

  ;; 构造与比较：位置<? / 位置<=? / 位置=?
  (check-equal? (位置 2 3) (位置 2 3))
  (check-true  (位置<? (位置 1 9) (位置 2 0)))
  (check-true  (位置<? (位置 1 1) (位置 1 2)))
  (check-false (位置<? (位置 1 2) (位置 1 2)))
  (check-true  (位置<=? (位置 1 2) (位置 1 2)))
  (check-true  (位置=? (位置 4 0) (位置 4 0)))
  (check-false (位置=? (位置 4 0) (位置 0 4)))

  ;; 裸比较：比较器只有一份实现
  (check-true (坐标<? 0 5 1 0))
  (check-true (坐标=? 3 2 3 2))
  (check-true (坐标<=? 3 2 3 2))
  (check-false (坐标<=? 3 3 3 2))

  ;; 夹紧：行越界、列越界分别夹；合法域内不动
  (define n 3)
  (define (长度 l) (list-ref '(2 3 5) l))
  (check-equal? (位置-夹紧 (位置 1 1) n 长度) (位置 1 1))
  (check-equal? (位置-夹紧 (位置 9 9) n 长度) (位置 2 5))
  (check-equal? (位置-夹紧 (位置 -2 -2) n 长度) (位置 0 0))
  (check-equal? (位置-夹紧 (位置 1 99) n 长度) (位置 1 3))

  (displayln "point.rkt: all tests passed"))
