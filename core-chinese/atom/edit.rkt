#lang racket

(require "point.rkt" "lines.rkt" rackunit)

;;; atom/edit.rkt —— 文本变更原子（编辑-描述）+ 位置代数
;;;
;;;   编辑-描述     一次替换 [起点,末尾) → 新-文本（坐标全为「操作前」）
;;;
;;; 位置代数（属性集 / 账本 / 视图重基准共用）：
;;;   编辑描述-映射位置    编辑前位置 → 编辑后位置（#f = 落在被删区间内）
;;;   编辑描述-之后的-位置  插入文本之后的点
;;;   编辑-描述-逆         由生效 描述 + 旧文本求逆
;;;
;;; 「一串 描述」的代数也在这里（doc/视口 共用）：
;;;   编辑列表-规范化           排序 + 重叠检查
;;;   编辑列表-映射-位置        把一个点依次映射过一串（施加顺序的）编辑
;;;   编辑列表-跨度                 一串编辑影响到的行区间并集（增量重绘用）
;;;
;;; 只依赖 位置 与 行列表，不认识 内容/缓冲 —— 这是最底层的变更原子。

(require racket/list)

(provide
 (struct-out 编辑-描述)
 编辑描述-映射位置
 编辑描述-之后的-位置
 编辑-描述-逆
 编辑列表-规范化
 编辑列表-映射-位置
 编辑列表-跨度)

;;; ---------- 数据 ----------

(struct 编辑-描述 (起点 末尾 新-文本) #:transparent)
;; 起点 / 末尾 : 位置     被替换的半开区间 [起点, 末尾)（操作前坐标）
;; 新-文本    : string    取代该区间的文本（可含 \n）

;;; ---------- 批规范化 ----------

;; 输入 描述集 都在同一坐标系里、应两两不重叠。返回按起点升序（同起点保持输入次序）
;; 的列表；发现重叠（半开：下一个.起点 < 上一个.末尾）→ 具名报错。
;; 供 doc 层的批量文本施加与 变更 漏斗共用。
(define (编辑列表-规范化 报错者 描述集)
  (define 已排序
    (sort (for/list ([i (in-naturals)] [d (in-list 描述集)]) (cons i d))
          (lambda (a b)
            (define da (cdr a)) (define db (cdr b))
            (cond [(位置<? (编辑-描述-起点 da) (编辑-描述-起点 db)) #t]
                  [(位置<? (编辑-描述-起点 db) (编辑-描述-起点 da)) #f]
                  [else (< (car a) (car b))]))))
  (when (>= (length 已排序) 2)
    (for ([a (in-list (drop-right 已排序 1))] [d (in-list (rest 已排序))])
      (when (位置<? (编辑-描述-起点 (cdr d)) (编辑-描述-末尾 (cdr a)))
        (error 报错者 "编辑重叠: ~a 与 ~a" (cdr a) (cdr d)))))
  (map cdr 已排序))

;;; ---------- 描述 代数（位置如何随一次编辑移动）----------
;; 全部只认 位置。

;; 编辑前位置 p → 编辑后位置；返回 位置 或 #f（#f = p 落在被删区间内，已不存在）。
(define (编辑描述-映射位置 d p)
  (define s (编辑-描述-起点 d))
  (define e (编辑-描述-末尾 d))
  (define sl (位置-行 s)) (define sc (位置-列 s))
  (define el (位置-行 e)) (define ec (位置-列 e))
  (define l (位置-行 p)) (define c (位置-列 p))
  (define-values (k 末-长度) (字符串-行-几何 (编辑-描述-新-文本 d)))
  (define 增量 (- k (- el sl) 1))            ; 行数变化：k - (el-sl+1)
  (cond
    [(or (坐标<? l c sl sc) (坐标=? l c sl sc)) (位置 l c)]   ; 起点及之前不动
    [(坐标<? l c el ec) #f]                                    ; 落在被删区间内
    [else                                                     ; 在 末尾 之后
     (cond
       [(= l el)
        (cond
          [(= k 1)   (位置 sl (+ sc 末-长度 (- c ec)))]     ; 单行插入：含起点列
          [else      (位置 (+ sl (sub1 k)) (+ 末-长度 (- c ec)))])]
       [else (位置 (+ l 增量) c)])]))

;; 插入文本之后的点（'after' 语义 / 逆编辑的终点 / 光标推进落点）。
(define (编辑描述-之后的-位置 d)
  (define s (编辑-描述-起点 d))
  (define 文本 (编辑-描述-新-文本 d))
  (define-values (k 末-长度) (字符串-行-几何 文本))
  (cond
    [(= k 1)   (位置 (位置-行 s) (+ (位置-列 s) (string-length 文本)))]
    [else      (位置 (+ (位置-行 s) (sub1 k)) 末-长度)]))

;; 逆编辑：抵消 d 的那次编辑。用「d 生效后的新坐标系」表示。
;;   · 区间 = [d.起点, d 插入文本之后)
;;   · 文本 = d 删掉的旧文本（调用方传入——编辑-描述 不含旧文本）
(define (编辑-描述-逆 d 旧-文本)
  (编辑-描述 (编辑-描述-起点 d) (编辑描述-之后的-位置 d) 旧-文本))

;;; ---------- 一串 描述 的代数（位置映射 / 变更行区间）----------

;; 把 p 依次映射过 描述集（**施加顺序**）。落在某次删除区间内 → 落到该区间起点。
;; 恰好落在一次零宽插入的点上 → 落到插入文本之后（光标跟随右边文本）。
(define (编辑列表-映射-位置 描述集 p)
  (for/fold ([p p]) ([d (in-list 描述集)])
    (cond
      [(and (位置=? p (编辑-描述-起点 d))
            (位置=? (编辑-描述-起点 d) (编辑-描述-末尾 d)))
       (编辑描述-之后的-位置 d)]
      [else (or (编辑描述-映射位置 d p) (编辑-描述-起点 d))])))

;; 一串编辑影响到的行区间并集（新坐标系）：(values 首行 末行)；空 → (values #f #f)。
(define (编辑列表-跨度 描述集)
  (for/fold ([f #f] [l #f]) ([d (in-list 描述集)])
    (define sl (位置-行 (编辑-描述-起点 d)))
    (define el (+ sl (sub1 (字符串-行-数量 (编辑-描述-新-文本 d)))))
    (values (if f (min f sl) sl) (if l (max l el) el))))

;;; ---------- 测试 ----------

(module+ test
  (define d-sp (编辑-描述 (位置 0 1) (位置 2 1) "XY\nZ"))
  (check-equal? (编辑描述-映射位置 d-sp (位置 0 0)) (位置 0 0))
  (check-equal? (编辑描述-映射位置 d-sp (位置 0 1)) (位置 0 1))   ; 起点
  (check-false (编辑描述-映射位置 d-sp (位置 0 2)))               ; 被删
  (check-false (编辑描述-映射位置 d-sp (位置 1 0)))               ; 被删
  (check-equal? (编辑描述-映射位置 d-sp (位置 2 1)) (位置 1 1))  ; = 末尾
  (check-equal? (编辑描述-映射位置 d-sp (位置 2 3)) (位置 1 3))  ; 同行 末尾 之后

  (check-equal? (编辑描述-之后的-位置 d-sp) (位置 1 1))
  (check-equal? (编辑描述-之后的-位置 (编辑-描述 (位置 0 3) (位置 0 3) "XY")) (位置 0 5))
  (check-equal? (编辑描述-之后的-位置 (编辑-描述 (位置 2 4) (位置 2 4) "中")) (位置 2 5))
  (check-equal? (编辑描述-之后的-位置 (编辑-描述 (位置 0 1) (位置 0 3) "")) (位置 0 1))

  (check-equal? (编辑-描述-逆 (编辑-描述 (位置 0 2) (位置 0 5) "XY") "cde")
                (编辑-描述 (位置 0 2) (位置 0 4) "cde"))
  (check-equal? (编辑-描述-逆 (编辑-描述 (位置 1 0) (位置 2 3) "") "l1\nl2")
                (编辑-描述 (位置 1 0) (位置 1 0) "l1\nl2"))
  (check-equal? (编辑-描述-逆 (编辑-描述 (位置 0 0) (位置 0 0) "X") "")
                (编辑-描述 (位置 0 0) (位置 0 1) ""))

  ;; 编辑列表-规范化：排序 / 同起点保序 / 重叠报错
  (define (ds* . ds) ds)
  (check-equal? (map 编辑-描述-起点
                     (编辑列表-规范化 'x (list (编辑-描述 (位置 1 0) (位置 1 1) "")
                                               (编辑-描述 (位置 0 0) (位置 0 1) ""))))
                (list (位置 0 0) (位置 1 0)))
  (check-equal? (编辑列表-规范化 'x (list (编辑-描述 (位置 0 0) (位置 0 0) "A")
                                          (编辑-描述 (位置 0 0) (位置 0 0) "B")))
                (list (编辑-描述 (位置 0 0) (位置 0 0) "A")
                      (编辑-描述 (位置 0 0) (位置 0 0) "B")))
  (check-exn exn:fail?
             (lambda () (编辑列表-规范化 'x (list (编辑-描述 (位置 0 1) (位置 0 3) "")
                                                  (编辑-描述 (位置 0 2) (位置 0 4) "")))))

  ;; 编辑列表-映射-位置：零宽插入落到插入后；删除区间内吸附起点
  (check-equal? (编辑列表-映射-位置 (list (编辑-描述 (位置 0 1) (位置 0 1) "X")) (位置 0 1))
                (位置 0 2))
  (check-equal? (编辑列表-映射-位置 (list (编辑-描述 (位置 0 1) (位置 0 3) "")) (位置 0 2))
                (位置 0 1))

  ;; 编辑列表-跨度：行区间并集（新坐标系）
  (define (跨度 ds) (call-with-values (lambda () (编辑列表-跨度 ds)) list))
  (check-equal? (跨度 '()) (list #f #f))
  (check-equal? (跨度 (list (编辑-描述 (位置 0 1) (位置 0 3) ""))) (list 0 0))
  (check-equal? (跨度 (list (编辑-描述 (位置 1 0) (位置 1 0) "M\nN\n"))) (list 1 3))
  (check-equal? (跨度 (list (编辑-描述 (位置 2 0) (位置 2 1) "")
                            (编辑-描述 (位置 0 0) (位置 0 1) "")))
                (list 0 2))

  (displayln "edit.rkt: all tests passed"))
